server {
    listen 3000;
    root /usr/share/nginx/html;
    index index.html;

    # OAuth sign-in moves its payload through headers and the query string, and both
    # directions overflow nginx's defaults.
    #
    # Response: when a non-production environment signs in, production completes the
    # exchange and hands the profile back in the redirect - so /v1/auth/callback/:id
    # answers 302 with a Location several KB long (it carries the encrypted user info
    # plus the provider's access, refresh and id tokens; an OIDC id_token is ~1KB on
    # its own). Past the 4k default nginx discards the response with "upstream sent
    # too big header" and returns 502, which lands mid-sign-in as a blank page on a
    # callback URL. The API is fine and has already consumed the single-use code, so
    # a retry starts over rather than recovering.
    #
    # Request: that same state comes back from the provider as a ~3KB query param,
    # inside the request line rather than a header.
    proxy_buffer_size 32k;
    proxy_buffers 8 32k;
    proxy_busy_buffers_size 64k;
    large_client_header_buffers 4 32k;

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # The SPA entry document keeps a stable URL (it can't be content-hashed like
    # the assets it references), so it must always be revalidated. Otherwise a
    # client keeps loading an old index.html that points at asset hashes the
    # latest deploy already deleted. no-cache still allows cheap 304s via ETag
    # while guaranteeing a fresh build is picked up immediately. This exact-match
    # location also catches the try_files fallback below, since the internal
    # redirect to /index.html re-runs location matching.
    location = /index.html {
        add_header Cache-Control "no-cache";
        # Repeated, not inherited: nginx only inherits add_header into a location that
        # defines none of its own, and every HTML path lands here through the try_files
        # fallback below - so the server-level header never reaches a page a crawler reads.
        add_header Link '</.well-known/ai-catalog.json>; rel="ai-catalog"; type="application/json"' always;
    }

    # We no longer ship a service worker, but a browser that registered the old one
    # still polls this path, and a registration only goes away if the update fetch
    # 404s. Without this it would hit the SPA fallback below and get 200 text/html,
    # which fails the update as a MIME error and leaves the stale worker installed -
    # serving a precache of assets this deploy has already deleted. Keep the 404
    # until old registrations can be assumed gone.
    location = /sw.js {
        return 404;
    }

    # DO NOT rely on this /v1/ same-origin proxy from application code. Frontend
    # code must always address the API by its VITE_API_URL hostname, never via a
    # same-origin /v1/ path that depends on this nginx redirect. This block exists
    # only as a fallback for environments that need it; new call sites must use
    # VITE_API_URL directly.
    location /v1/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Cookie $http_cookie;
        proxy_pass_request_headers on;
    }

    # OAuth discovery for the MCP server. Better Auth advertises the authorization
    # server and protected-resource metadata at APP_URL (this UI origin), but the
    # metadata is served by the API. Without this, an MCP client's discovery fetch
    # falls through to the SPA and the OAuth handshake never starts. Everything
    # else under /.well-known/ (SPA-owned) still resolves via the SPA fallback.

    # Same reason as the catalog below, and the same failure if it is missing: without
    # this, /llms.txt falls through to the SPA and answers 200 with the app shell, which
    # an agent may then try to parse as llms.txt. A 404 would be less misleading.
    location = /llms.txt {
        proxy_pass http://${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_pass_request_headers on;
    }

    # An agent looking for us tries the brand domain, not the API host, so the
    # Agentic Resource Discovery catalog has to resolve here. Proxied rather than
    # duplicated: the API generates it from its own environment, so there is one
    # definition and an alpha deployment still advertises its own endpoints.
    location = /.well-known/ai-catalog.json {
        proxy_pass http://${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_pass_request_headers on;
    }

    location /.well-known/oauth- {
        proxy_pass http://${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_pass_request_headers on;
    }

    # Two distinct mount points, not one shared "/ingest": ad blocker filter lists target
    # well-known PostHog proxy path names, so events and feature flags are split - a
    # filter-list hit on one leaves the other working.
    location /rs/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_pass_request_headers on;
    }

    location /flags/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_pass_request_headers on;
    }

    # Agent discovery, third of three signals (see also robots.txt and the <link> tag in
    # index.html). Crawlers differ in which they read, so the catalog is advertised in all
    # three. This server-level copy covers the proxied locations; `location = /index.html`
    # repeats it because a location with its own add_header inherits none.
    add_header Link '</.well-known/ai-catalog.json>; rel="ai-catalog"; type="application/json"' always;

    location / {
        try_files $uri $uri/ /index.html;
    }
}
