{
    "name": "@autonoma/agent",
    "version": "1.260819.1",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "turbo run build",
        "ui": "turbo run dev --filter=@autonoma/ui",
        "dev": "turbo run dev --parallel --filter @autonoma/ui --filter @autonoma/api",
        "api": "turbo run dev --filter=@autonoma/api",
        "docs": "turbo run dev --filter=@autonoma/docs",
        "lint": "turbo run lint --continue",
        "fmt": "turbo run fmt",
        "format": "oxfmt --write .",
        "check": "oxlint --fix . && oxfmt --write .",
        "typecheck": "turbo run typecheck",
        "test": "turbo run test",
        "test:integration": "turbo run test:integration",
        "db:generate": "turbo run db:generate",
        "db:migrate": "turbo run db:migrate --filter=@autonoma/db",
        "agent:execute": "pnpm --filter @autonoma/api agent:execute",
        "db:restore": "tsx scripts/restore-db-from-backup.ts",
        "prepare": "husky",
        "fetch-secret": "node -e \"import('@autonoma-ai/envsync').then(({ saveSecretToEnv }) => saveSecretToEnv())\""
    },
    "devDependencies": {
        "@autonoma-ai/envsync": "^2.0.1",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.7",
        "oxfmt": "0.42.0",
        "oxlint": "1.57.0",
        "prisma": "catalog:",
        "tsx": "catalog:",
        "turbo": "^2.9.18",
        "typescript": "catalog:",
        "zod": "catalog:"
    },
    "engines": {
        "node": ">=24"
    },
    "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
    "envsync": {
        "secretName": "dev/agent",
        "envFile": ".env",
        "region": "us-east-1"
    }
}
