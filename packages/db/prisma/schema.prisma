generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["tracing"]
}

datasource db {
  provider = "postgresql"
}

generator json {
  provider = "prisma-json-types-generator"
}

// ─── Better Auth Core Models ────────────────────────────────────────

enum UserRole {
  user
  admin

  @@map("user_role")
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  role          UserRole @default(user)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  /// The organization this account last chose to act as, and therefore where a new session starts.
  /// Null until they have ever chosen - a fresh account, or one that has only ever had a single
  /// organization to be in. Cleared by `ON DELETE SET NULL` if that organization goes away, and
  /// re-pointed when they lose the membership, so it can never name an organization they are not in.
  lastOrganizationId String? @map("last_organization_id")

  sessions            Session[]
  accounts            Account[]
  members             Member[]
  invitations         Invitation[]         @relation("invitations")
  apiKeys             ApiKey[]
  applicationSetups   ApplicationSetup[]
  signupHookStates    SignupHookState[]
  vercelInstallations VercelInstallation[]
  oauthApplications   OauthApplication[]
  oauthAccessTokens   OauthAccessToken[]
  oauthConsents       OauthConsent[]

  lastOrganization Organization? @relation("lastOrganization", fields: [lastOrganizationId], references: [id], onDelete: SetNull)

  @@index([lastOrganizationId])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  activeOrganizationId String? @map("active_organization_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  idToken               String?   @map("id_token")
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verification")
}

// ─── Organization Plugin Models ─────────────────────────────────────

model Organization {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  logo      String?
  metadata  String?
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  domain    String?            @unique
  status    OrganizationStatus @default(approved)

  /// When someone confirmed this organization's name, or null while it is still the auto-derived
  /// guess. An org created from a personal email address is named after whoever signed up first,
  /// who is not necessarily whose organization it is - so those are asked to name it once, and
  /// this is what stops the prompt reappearing. Orgs derived from a real email domain, and the
  /// internal org, are stamped at creation and never prompt.
  nameConfirmedAt DateTime? @map("name_confirmed_at")

  members                 Member[]
  lastChosenByUsers       User[]                   @relation("lastOrganization")
  invitations             Invitation[]
  apiKeys                 ApiKey[]
  applications            Application[]
  branchDeployments       BranchDeployment[]
  webDeployments          WebDeployment[]
  mobileDeployments       MobileDeployment[]
  folders                 Folder[]
  branches                Branch[]
  testCases               TestCase[]
  testPlans               TestPlan[]
  testGenerations         TestGeneration[]
  stepInputLists          StepInputList[]
  stepInputs              StepInput[]
  stepOutputLists         StepOutputList[]
  stepOutputs             StepOutput[]
  stepAttempts            StepAttempt[]
  tags                    Tag[]
  scenarios               Scenario[]
  scenarioRecipeVersions  ScenarioRecipeVersion[]
  scenarioRecipeEdits     ScenarioRecipeEdit[]
  scenarioInstances       ScenarioInstance[]
  githubInstallation      GitHubInstallation?
  billingPricing          BillingPricing?
  settings                OrganizationSettings?
  promoRedemptions        BillingPromoRedemption[]
  billingCustomer         BillingCustomer?
  applicationSetups       ApplicationSetup[]
  signupHookStates        SignupHookState[]
  previewkitEnvironments  PreviewkitEnvironment[]
  analysisJobs            AnalysisJob[]
  analysisReports         AnalysisReport[]
  analysisFindings        AnalysisFinding[]
  analysisClassifications AnalysisClassification[]
  analysisIssues          AnalysisIssue[]
  analysisIssueVersions   AnalysisIssueVersion[]
  vercelInstallations     VercelInstallation[]

  @@map("organization")
}

enum OnboardingStep {
  install
  configure
  working
  webhook_configuring
  discovering
  discovered
  dry_run_passed
  url
  github
  preview_environment
  previewkit_configuring
  previewkit_deploying
  existing_deploys_configuring
  existing_deploys_waiting
  preview_verified
  diff_trigger
  completed

  @@map("onboarding_step")
}

enum OnboardingPreviewEnvironmentMode {
  previewkit
  existing_deploys

  @@map("onboarding_preview_environment_mode")
}

enum OnboardingPreviewVerificationStatus {
  idle
  building
  ready
  failed

  @@map("onboarding_preview_verification_status")
}

model OnboardingState {
  id                        String                              @id @default(cuid())
  applicationId             String                              @unique @map("application_id")
  step                      OnboardingStep                      @default(github) @map("step")
  agentConnectedAt          DateTime?                           @map("agent_connected_at")
  /// [AgentLogs]
  agentLogs                 Json                                @default("[]") @map("agent_logs")
  productionUrl             String?                             @map("production_url")
  previewEnvironmentMode    OnboardingPreviewEnvironmentMode?   @map("preview_environment_mode")
  previewUrl                String?                             @map("preview_url")
  previewVerificationStatus OnboardingPreviewVerificationStatus @default(idle) @map("preview_verification_status")
  // Why the last verification failed, in the words the user was shown. Kept because the
  // diagnosis is derived from a state transition and destroyed by the act of recording it:
  // readiness explains the failure while the previous status still reads `building`, and
  // writing `failed` is what moves it off `building`. Without this the next poll falls
  // through to a generic "nothing has been started yet", which reads as if the deploy was
  // never attempted. Cleared whenever verification succeeds.
  previewVerificationError  String?                             @map("preview_verification_error")
  // When a previewkit main-branch deploy was last requested. This is the freshness
  // reference readiness uses to decide whether the environment reflects the current
  // deploy: `updatedAt` is bumped by unrelated writes (notably the agent heartbeat),
  // so comparing environment activity against it drifts past the ready moment and the
  // deploy is never observed as ready. This only changes when a deploy is requested.
  previewDeployRequestedAt  DateTime?                           @map("preview_deploy_requested_at")
  completedAt               DateTime?                           @map("completed_at")
  lastDiscoveryError        String?                             @map("last_discovery_error")
  lastDiscoveredAt          DateTime?                           @map("last_discovered_at")
  lastDiscoveredModels      Int?                                @map("last_discovered_models")
  discoveringStartedAt      DateTime?                           @map("discovering_started_at")
  // SDK dry-run succeeded (a capability tracked outside the linear `step` so it
  // can be (re)run from the Finish setup tab at any time, not just onboarding).
  dryRunPassedAt            DateTime?                           @map("dry_run_passed_at")
  // First real per-PR `deployment_status` observed. Backs the optimistic BYO
  // diff-trigger self-confirmation (Live is marked before this is set).
  diffTriggerConfirmedAt    DateTime?                           @map("diff_trigger_confirmed_at")

  // --- Agentic onboarding: a coding agent drives the previewkit config over MCP ---
  // Who currently drives the config. Default `human` (the user starts in the UI);
  // the agent's first claim is a deliberate human -> agent handoff, and Stop /
  // Take over flips it back. Agent-held => the UI is read-only. Distinct from
  // `agentConnectedAt` (mere presence): this is the soft mutex for who may write.
  agentHolder           OnboardingAgentHolder @default(human) @map("agent_holder")
  // Heartbeat: refreshed on every agent tool call. The UI derives an idle release
  // (control handed back to the human) from `now - agentLastActivityAt` at read
  // time - no Redis, no background reaper.
  agentLastActivityAt   DateTime?             @map("agent_last_activity_at")
  // A question only the human can answer, raised by the agent and rendered inline
  // in the locked UI (env values to enter, or a choice). Null when the agent is
  // not blocked. Secret VALUES never appear here - only the KEYS asked for.
  /// [OnboardingAgentPendingRequest]
  agentPendingRequest   Json?                 @map("agent_pending_request")
  // Short-lived, single-use pairing code shown in the UI so the user can hand the
  // agent this app without a mutable repo name: the agent presents it and we map
  // it to this app + org (already fixed here from the UI's authenticated context).
  agentPairingCode      String?               @unique @map("agent_pairing_code")
  agentPairingExpiresAt DateTime?             @map("agent_pairing_expires_at")
  // Which coding agent is driving, from the MCP `clientInfo` handshake (e.g.
  // "claude-code", "cursor", "codex"). Best-effort - null when the client did not
  // report it - so the UI can name the agent ("Cursor is configuring...") instead
  // of hardcoding one, falling back to a neutral label when unknown.
  agentClient           String?               @map("agent_client")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("onboarding_state")
}

enum OnboardingAgentHolder {
  human
  agent

  @@map("onboarding_agent_holder")
}

// ─── Application Setup ──────────────────────────────────────────────

model ApplicationSetup {
  id           String    @id @default(cuid())
  name         String?
  status       String    @default("running")
  currentStep  Int       @default(0) @map("current_step")
  totalSteps   Int       @default(5) @map("total_steps")
  errorMessage String?   @map("error_message")
  completedAt  DateTime? @map("completed_at")

  applicationId  String       @map("application_id")
  application    Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  events ApplicationSetupEvent[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([applicationId])
  @@index([organizationId])
  @@index([userId])
  @@map("application_setup")
}

model ApplicationSetupEvent {
  id        String           @id @default(cuid())
  type      String
  data      Json             @default("{}")
  setupId   String           @map("setup_id")
  setup     ApplicationSetup @relation(fields: [setupId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([setupId])
  @@map("application_setup_event")
}

model Member {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  role           String
  createdAt      DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("member")
}

model Invitation {
  id             String   @id @default(cuid())
  email          String
  inviterId      String   @map("inviter_id")
  organizationId String   @map("organization_id")
  role           String
  status         String   @default("pending")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  inviter      User         @relation("invitations", fields: [inviterId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([inviterId])
  @@index([organizationId])
  @@map("invitation")
}

model SignupHookState {
  id             String @id @default(cuid())
  userId         String @map("user_id")
  organizationId String @map("organization_id")

  newsletterAddedAt         DateTime? @map("newsletter_added_at")
  defaultWelcomeEmailSentAt DateTime? @map("default_welcome_email_sent_at")
  premiumWelcomeEmailSentAt DateTime? @map("premium_welcome_email_sent_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("signup_hook_state")
}

// --- Application Models ─────────────────────────────────────────────

enum ApplicationArchitecture {
  WEB
  IOS
  ANDROID

  @@map("application_architecture")
}

model Application {
  id                  String                  @id @default(cuid())
  name                String
  slug                String                  @map("slug")
  architecture        ApplicationArchitecture
  customInstructions  String?                 @map("custom_instructions")
  testScopeGuidelines String?                 @map("test_scope_guidelines")
  disabled            Boolean                 @default(false)
  githubRepositoryId  Int?                    @map("github_repository_id")

  mainBranchId String? @unique @map("main_branch_id")
  mainBranch   Branch? @relation("MainBranch", fields: [mainBranchId], references: [id])

  // The git ref the base preview (environment 0) builds from, when it is NOT the
  // app's trunk - typically an integration branch carrying preview config that has
  // not been merged yet. Null means "deploy the trunk". This is deliberately NOT
  // the main-branch record: that one is the app's trunk identity and drives suite
  // lineage, merge reconciliation and every "main" label, so overwriting it to
  // redirect a preview silently redefines what main means.
  previewDeployRef String? @map("preview_deploy_ref")

  signingSecretEnc String? @map("signing_secret_enc")

  folders                  Folder[]
  testCases                TestCase[]
  tags                     Tag[]
  scenarios                Scenario[]
  scenarioSchemaSnapshots  ScenarioSchemaSnapshot[]
  scenarioRecipeVersions   ScenarioRecipeVersion[]
  scenarioRecipeEdits      ScenarioRecipeEdit[]
  scenarioInstances        ScenarioInstance[]
  webhookCalls             WebhookCall[]
  branches                 Branch[]
  featureBranchInfos       FeatureBranchInfo[]
  mainBranchInfo           MainBranchInfo?
  onboardingState          OnboardingState?
  applicationSetups        ApplicationSetup[]
  vercelProjectConnections VercelProjectConnection[]

  // The Application's preview config (latest-only; saving overwrites it in
  // place). No row means the Application has no preview config and its
  // previews are skipped (opt-out) rather than erroring. This is the config the
  // deploy pipeline reads.
  previewkitConfig PreviewkitConfig?

  // Per-repo activation trigger config
  triggerConfig ApplicationTriggerConfig?

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([name, organizationId])
  @@unique([slug, organizationId])
  @@unique([organizationId, githubRepositoryId])
  @@map("application")
}

// ─── Branch Deployment ────────────────────────────────────────────────────────

model BranchDeployment {
  id     String  @id @default(cuid())
  active Boolean @default(true)

  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  webhookUrl     String? @map("webhook_url")
  /// ![Record<string, string>]
  webhookHeaders Json?   @map("webhook_headers")

  activeOnBranch    Branch?            @relation("ActiveDeployment")
  scenarioInstances ScenarioInstance[]
  webDeployment     WebDeployment?
  mobileDeployment  MobileDeployment?

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([organizationId])
  @@map("branch_deployment")
}

model WebDeployment {
  deploymentId String           @map("deployment_id")
  deployment   BranchDeployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  url  String
  file String?

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([deploymentId])
  @@index([organizationId])
  @@map("web_deployment")
}

model MobileDeployment {
  deploymentId String           @map("deployment_id")
  deployment   BranchDeployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  packageUrl  String @map("package_url")
  photo       String @map("photo")
  packageName String @map("package_name")

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([deploymentId])
  @@index([organizationId])
  @@map("mobile_deployment")
}

// ─── API Key Plugin Model ───────────────────────────────────────────

model ApiKey {
  id                  String    @id @default(cuid())
  name                String?
  start               String?
  prefix              String?
  key                 String
  userId              String    @map("user_id")
  organizationId      String    @map("organization_id")
  refillInterval      Int?      @map("refill_interval")
  refillAmount        Int?      @map("refill_amount")
  lastRefillAt        DateTime? @map("last_refill_at")
  enabled             Boolean   @default(true)
  rateLimitEnabled    Boolean   @default(false) @map("rate_limit_enabled")
  rateLimitTimeWindow Int?      @map("rate_limit_time_window")
  rateLimitMax        Int?      @map("rate_limit_max")
  requestCount        Int       @default(0) @map("request_count")
  remaining           Int?
  lastRequest         DateTime? @map("last_request")
  expiresAt           DateTime? @map("expires_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  permissions         String?
  metadata            String?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@map("api_key")
}

// ─── Better Auth: MCP OAuth (jwt + mcp/oidc-provider plugins) ───────
// Backing tables for the `jwt()` and `mcp()` plugins in apps/api/src/auth.ts.
// The jwt plugin signs a JWT on every session response, so `Jwks` is read on
// normal app operation, not only the MCP OAuth path. Field names mirror
// better-auth's plugin schema exactly (it queries by Prisma field name); the
// snake_case columns are transparent to it.

model Jwks {
  id         String    @id @default(cuid())
  publicKey  String    @map("public_key")
  privateKey String    @map("private_key")
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime? @map("expires_at")

  @@map("jwks")
}

model OauthApplication {
  id           String   @id @default(cuid())
  name         String
  icon         String?
  metadata     String?
  clientId     String   @unique @map("client_id")
  clientSecret String?  @map("client_secret")
  redirectUrls String   @map("redirect_urls")
  type         String
  disabled     Boolean? @default(false)
  userId       String?  @map("user_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user         User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokens OauthAccessToken[]
  consents     OauthConsent[]

  @@index([userId])
  @@map("oauth_application")
}

model OauthAccessToken {
  id                    String   @id @default(cuid())
  accessToken           String   @unique @map("access_token")
  refreshToken          String   @unique @map("refresh_token")
  accessTokenExpiresAt  DateTime @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime @map("refresh_token_expires_at")
  clientId              String   @map("client_id")
  userId                String?  @map("user_id")
  scopes                String
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  application OauthApplication @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user        User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@map("oauth_access_token")
}

model OauthConsent {
  id           String   @id @default(cuid())
  clientId     String   @map("client_id")
  userId       String   @map("user_id")
  scopes       String
  consentGiven Boolean  @map("consent_given")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  application OauthApplication @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@map("oauth_consent")
}

// ─── Enums ─────────────────────────────────────────────────────────

enum OrganizationStatus {
  pending
  approved
  rejected

  @@map("organization_status")
}

// ─── Organization & Test Structure ─────────────────────────────────

model Folder {
  id            String      @id @default(cuid())
  name          String
  description   String?
  applicationId String      @map("application_id")
  parentId      String?     @map("parent_id")
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  parent        Folder?     @relation("FolderTree", fields: [parentId], references: [id])
  children      Folder[]    @relation("FolderTree")
  testCases     TestCase[]

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, parentId, name])
  @@index([organizationId])
  @@map("folder")
}

// ─── Branch & Versioning ──────────────────────────────────────────────────────

model Branch {
  id   String @id @default(cuid())
  name String

  applicationId String      @map("application_id")
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  deploymentId String?           @unique @map("deployment_id")
  deployment   BranchDeployment? @relation("ActiveDeployment", fields: [deploymentId], references: [id])

  activeSnapshotId  String?         @unique @map("active_snapshot_id")
  activeSnapshot    BranchSnapshot? @relation("ActiveSnapshot", fields: [activeSnapshotId], references: [id])
  pendingSnapshotId String?         @unique @map("pending_snapshot_id")
  pendingSnapshot   BranchSnapshot? @relation("PendingSnapshot", fields: [pendingSnapshotId], references: [id])
  baseSnapshotId    String?         @map("base_snapshot_id")
  baseSnapshot      BranchSnapshot? @relation("BaseSnapshot", fields: [baseSnapshotId], references: [id])

  mainOfApplication Application?       @relation("MainBranch")
  snapshots         BranchSnapshot[]
  deployments       BranchDeployment[]
  analysisIssues    AnalysisIssue[]

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  prInfo   FeatureBranchInfo?
  mainInfo MainBranchInfo?

  previewkitEnvironment PreviewkitEnvironment?

  @@index([applicationId])
  @@index([organizationId])
  @@map("branch")
}

enum PullRequestCacheState {
  open
  closed
  merged

  @@map("pull_request_cache_state")
}

model FeatureBranchInfo {
  branchId      String @id @map("branch_id")
  applicationId String @map("application_id")
  prNumber      Int    @map("pr_number")

  // Cached PR metadata (best-effort; filled by GitHub webhooks + the polite revalidate).
  // All nullable: an empty cache is valid and is backfilled lazily.
  prTitle       String?                @map("pr_title")
  prState       PullRequestCacheState? @map("pr_state")
  prAuthorLogin String?                @map("pr_author_login")
  prUpdatedAt   DateTime?              @map("pr_updated_at") // GitHub's updated_at (drives the "Updated" column)
  prCachedAt    DateTime?              @map("pr_cached_at") // our last write time (drives the freshness/throttle gate)

  // Merge outcome facts, written on `pull_request.closed` with `merged === true`. All nullable: a still-open or
  // closed-unmerged PR leaves them absent.
  mergedAt       DateTime? @map("merged_at")
  mergeCommitSha String?   @map("merge_commit_sha")
  mergedByLogin  String?   @map("merged_by_login")

  branch      Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, prNumber])
  @@index([applicationId, prCachedAt])
  @@map("feature_branch_info")
}

model MainBranchInfo {
  branchId      String @id @map("branch_id")
  applicationId String @unique @map("application_id")
  githubRef     String @map("github_ref")

  branch      Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("main_branch_info")
}

enum TriggerSource {
  GITHUB_PUSH
  MANUAL
  WEBHOOK

  @@map("trigger_source")
}

enum SnapshotStatus {
  processing
  active
  superseded
  failed
  cancelled

  @@map("snapshot_status")
}

model BranchSnapshot {
  id        String         @id @default(cuid())
  status    SnapshotStatus @default(processing)
  createdAt DateTime       @default(now()) @map("created_at")

  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  source  TriggerSource
  headSha String?       @map("head_sha")
  baseSha String?       @map("base_sha")
  /// [JsonValue]
  payload Json?

  prevSnapshotId String?          @map("prev_snapshot_id")
  prevSnapshot   BranchSnapshot?  @relation("SnapshotHistory", fields: [prevSnapshotId], references: [id])
  nextSnapshots  BranchSnapshot[] @relation("SnapshotHistory")

  // Per-dependency deployed commit SHAs (keyed by repo full name `owner/repo`;
  // rows pinned before config v2 used the retired repo alias), pinned the first
  // time grounding runs for this snapshot by resolving the headSha-exact
  // PreviewkitEnvironment and copying its enriched resolvedConfig repo SHAs. All
  // agents in the snapshot read this pinned copy so a later redeploy can not
  // corrupt an in-flight snapshot's multi-repo fidelity. `null` = not yet
  // pinned; `{}` = pinned with no matching/partial manifest (degrade, never error).
  /// ![Record<string, string>]
  pinnedDependencyShas Json? @map("pinned_dependency_shas")

  testCaseAssignments     TestCaseAssignment[]
  scenarioSchemaSnapshots ScenarioSchemaSnapshot[]
  scenarioRecipeVersions  ScenarioRecipeVersion[]

  activeOnBranch  Branch?          @relation("ActiveSnapshot")
  pendingOnBranch Branch?          @relation("PendingSnapshot")
  baseOfBranches  Branch[]         @relation("BaseSnapshot")
  testGenerations TestGeneration[]

  analysisJob           AnalysisJob?
  analysisReport        AnalysisReport?
  investigationAiCosts  AiCostRecord[]         @relation("InvestigationAiCost")
  vercelDeployments     VercelDeployment[]
  analysisIssueVersions AnalysisIssueVersion[]

  @@index([branchId, createdAt])
  @@map("branch_snapshot")
}

model TestCaseAssignment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  snapshotId String         @map("snapshot_id")
  snapshot   BranchSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  testCaseId String   @map("test_case_id")
  testCase   TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  planId String?   @map("plan_id")
  plan   TestPlan? @relation(fields: [planId], references: [id])

  @@unique([snapshotId, testCaseId])
  @@index([testCaseId])
  @@index([planId])
  @@map("test_case_assignment")
}

// ─── Test Case ────────────────────────────────────────────────────────────────

model TestCase {
  id          String  @id @default(cuid())
  name        String
  slug        String
  description String?

  applicationId String      @map("application_id")
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  folderId String @map("folder_id")
  folder   Folder @relation(fields: [folderId], references: [id], onDelete: Restrict)

  plans       TestPlan[]
  tags        TestTag[]
  assignments TestCaseAssignment[]

  analysisFindings       AnalysisFinding[]
  /// The issue restatements that designated this test as their clearest reproduction.
  primaryOfIssueVersions AnalysisIssueVersion[] @relation("IssueVersionPrimaryTestCase")
  /// Retired back-relation of the kept `AnalysisIssue.primaryTestCase`; drops with that column one deploy later (#2580).
  primaryOfIssues        AnalysisIssue[]        @relation("IssuePrimaryTestCase")

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, slug])
  @@index([organizationId])
  @@map("test_case")
}

// ─── Test Generation ───────────────────────────────────────────────────────────

model TestPlan {
  id String @id @default(cuid())

  testCaseId String   @map("test_case_id")
  testCase   TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  prompt       String
  scenarioId   String?   @map("scenario_id")
  scenario     Scenario? @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  scenarioName String?   @map("scenario_name")

  generations TestGeneration[]
  stepLists   StepInputList[]
  assignments TestCaseAssignment[]

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([testCaseId])
  @@index([organizationId])
  @@map("test_plan")
}

enum GenerationStatus {
  pending
  queued
  running
  success
  failed

  @@map("generation_status")
}

model TestGeneration {
  id         String @id @default(cuid())
  testPlanId String @map("test_plan_id")

  status          GenerationStatus @default(pending)
  reasoning       String?          @map("reasoning")
  finalScreenshot String?          @map("final_screenshot")
  videoUrl        String?          @map("video_url")

  /// S3 key for the reviewer-optimized recording (dead time stripped, timeline collapsed), signed on read like
  /// `videoUrl`. Present only once the optimization pass has run for this generation; the UI offers an
  /// "optimized" playback toggle when set and falls back to `videoUrl` otherwise.
  optimizedVideoUrl String? @map("optimized_video_url")

  /// Structured failure detail. Set iff status == failed (for rows created
  /// after this column existed; historical failed rows have null). System
  /// failures (scenario_setup, engine_error) carry a message and render in the
  /// critical failure panel; agent_failed/max_steps render via the agent UI.
  /// [GenerationFailure]
  failure Json? @map("failure")

  snapshotId String         @map("snapshot_id")
  snapshot   BranchSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)

  /// [ModelConversation]
  conversation Json @default("[]")

  /// S3 URL where the full conversation JSON is stored
  conversationUrl String? @map("conversation_url")

  /// Extracted variables from the agent's memory system
  memory Json @default("{}") @map("memory")

  testPlan    TestPlan       @relation(fields: [testPlanId], references: [id], onDelete: Cascade)
  costRecords AiCostRecord[]
  attempts    StepAttempt[]

  /// The analysis findings whose verdict this run produced. A list rather than one row because a re-filed
  /// containment finding can overwrite in place while an earlier self-heal pass still points here.
  analysisClassifications AnalysisClassification[]

  scenarioInstanceId String?           @map("scenario_instance_id")
  scenarioInstance   ScenarioInstance? @relation(fields: [scenarioInstanceId], references: [id], onDelete: SetNull)

  stepsId   String?         @map("steps_id")
  steps     StepInputList?  @relation(fields: [stepsId], references: [id])
  outputsId String?         @unique @map("outputs_id")
  outputs   StepOutputList? @relation(fields: [outputsId], references: [id])

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([organizationId])
  @@index([testPlanId])
  @@index([stepsId])
  @@map("test_generation")
}

// ─── Step Input / Output ──────────────────────────────────────────────────────

model StepInputList {
  id   String      @id @default(cuid())
  list StepInput[]

  planId String   @map("plan_id")
  plan   TestPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  generations TestGeneration[]

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([planId])
  @@map("step_input_list")
}

model StepInput {
  id     String @id @default(cuid())
  listId String @map("list_id")
  order  Int

  interaction String
  /// ![object]
  params      Json

  screenshotBefore String? @map("screenshot_before")
  screenshotAfter  String? @map("screenshot_after")

  list    StepInputList @relation(fields: [listId], references: [id], onDelete: Cascade)
  outputs StepOutput[]

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([listId, order])
  @@index([listId])
  @@index([organizationId])
  @@map("step_input")
}

model StepOutputList {
  id   String       @id @default(cuid())
  list StepOutput[]

  generation TestGeneration?

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("step_output_list")
}

model StepOutput {
  id     String @id @default(cuid())
  listId String @map("list_id")
  order  Int

  /// ![object]
  output Json

  stepInputId String    @map("step_input_id")
  stepInput   StepInput @relation(fields: [stepInputId], references: [id], onDelete: Cascade)

  screenshotBefore String? @map("screenshot_before")
  screenshotAfter  String? @map("screenshot_after")

  list StepOutputList @relation(fields: [listId], references: [id], onDelete: Cascade)

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([listId, order])
  @@index([listId])
  @@index([organizationId])
  @@index([stepInputId])
  @@map("step_output")
}

enum StepAttemptStatus {
  success
  failed

  @@map("step_attempt_status")
}

// Records every command attempt a generation makes - successes and failures
// alike - capturing the full attempt timeline. Unlike StepInput (the
// successful-only replay list), StepAttempt.order counts failures too. There is
// intentionally no FK linking a StepAttempt to its corresponding StepInput.
model StepAttempt {
  id    String @id @default(cuid())
  // Position in the full attempt timeline, counting failures.
  order Int

  interaction String
  // Command params, as provided to the command. Absent if param extraction threw.
  /// ![object]
  params      Json?

  status StepAttemptStatus

  // Command result, present on success.
  /// ![object]
  output    Json?
  // error.message, present on failure.
  error     String?
  // error class name, present on failure (attribution signal).
  errorName String? @map("error_name")

  screenshotBefore String? @map("screenshot_before")
  screenshotAfter  String? @map("screenshot_after")

  generationId String         @map("generation_id")
  generation   TestGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([generationId, order])
  @@index([generationId])
  @@index([organizationId])
  @@map("step_attempt")
}

// ─── Tag ──────────────────────────────────────────────────────────────────────

model Tag {
  id            String @id @default(cuid())
  name          String
  color         String
  applicationId String @map("application_id")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  testTags    TestTag[]

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([organizationId])
  @@map("tag")
}

model TestTag {
  id         String @id @default(cuid())
  testCaseId String @map("test_case_id")
  tagId      String @map("tag_id")

  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([testCaseId, tagId])
  @@index([tagId])
  @@map("test_tag")
}

// ─── AI Cost Tracking ─────────────────────────────────────────────

model AiCostRecord {
  id                      String  @id @default(cuid())
  generationId            String? @map("generation_id")
  investigationSnapshotId String? @map("investigation_snapshot_id")

  // Denormalized from whichever of generation/investigationSnapshot the row is
  // tied to (itself resolved through branch -> application) - deliberately, so
  // billing queries never need a multi-hop join to explain a charge. Set once at
  // insert time from the same lookup the caller already did to log/persist the
  // record, and never changes after.
  organizationId String @map("organization_id")

  model            String
  tag              String
  inputTokens      Int      @map("input_tokens")
  outputTokens     Int      @map("output_tokens")
  reasoningTokens  Int      @default(0) @map("reasoning_tokens")
  cacheReadTokens  Int      @default(0) @map("cache_read_tokens")
  costMicrodollars Int      @map("cost_microdollars")
  createdAt        DateTime @default(now()) @map("created_at")

  generation TestGeneration? @relation(fields: [generationId], references: [id], onDelete: Cascade)

  // Orchestration LLM spend for an investigation, keyed on its (detached) snapshot.
  // Set for the investigation workflow's select/classify/diagnose/merge calls, which
  // are tied to neither a user generation nor a run.
  investigationSnapshot BranchSnapshot? @relation("InvestigationAiCost", fields: [investigationSnapshotId], references: [id], onDelete: Cascade)

  @@index([generationId])
  @@index([investigationSnapshotId])
  @@index([organizationId])
  @@map("ai_cost_record")
}

// ─── Scenario Setup/Teardown ──────────────────────────────────────

/// Who wrote a recipe edit. `PLANNER` is the one-time upload that seeds an app's recipes during
/// onboarding; `UI` and `MCP` are the edits made afterwards, by a person or by an agent. Knowing
/// which is which is what lets a later reader answer "who last changed this, and can I undo it".
enum ScenarioRecipeEditSource {
  PLANNER
  UI
  MCP

  @@map("scenario_recipe_edit_source")
}

enum ScenarioInstanceStatus {
  REQUESTED
  UP_SUCCESS
  UP_FAILED
  RUNNING_TESTS
  DOWN_SUCCESS
  DOWN_FAILED

  @@map("scenario_instance_status")
}

enum WebhookAction {
  DISCOVER
  UP
  DOWN

  @@map("webhook_action")
}

model Scenario {
  id                    String  @id @default(cuid())
  applicationId         String  @map("application_id")
  name                  String
  description           String?
  activeRecipeVersionId String? @unique @map("active_recipe_version_id")

  lastSeenFingerprint  String?   @map("last_seen_fingerprint")
  lastDiscoveredAt     DateTime? @map("last_discovered_at")
  fingerprintChangedAt DateTime? @map("fingerprint_changed_at")
  isDisabled           Boolean   @default(false) @map("is_disabled")

  application         Application             @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  activeRecipeVersion ScenarioRecipeVersion?  @relation("ActiveScenarioRecipeVersion", fields: [activeRecipeVersionId], references: [id], onDelete: SetNull)
  recipeVersions      ScenarioRecipeVersion[] @relation("ScenarioRecipeVersionHistory")
  recipeEdits         ScenarioRecipeEdit[]
  instances           ScenarioInstance[]
  testPlans           TestPlan[]

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, name])
  @@index([organizationId])
  @@map("scenario")
}

model ScenarioSchemaSnapshot {
  id            String @id @default(cuid())
  applicationId String @map("application_id")
  snapshotId    String @map("snapshot_id")
  /// [ScenarioStructureJson]
  structureJson Json   @map("structure_json") @db.Json
  fingerprint   String

  application    Application             @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  snapshot       BranchSnapshot          @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  recipeVersions ScenarioRecipeVersion[]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([applicationId, snapshotId])
  @@index([applicationId])
  @@index([snapshotId])
  @@map("scenario_schema_snapshot")
}

model ScenarioRecipeVersion {
  id                   String   @id @default(cuid())
  scenarioId           String   @map("scenario_id")
  snapshotId           String   @map("snapshot_id")
  schemaSnapshotId     String   @map("schema_snapshot_id")
  applicationId        String   @map("application_id")
  organizationId       String   @map("organization_id")
  scenarioNameSnapshot String   @map("scenario_name_snapshot")
  description          String?
  fingerprint          String
  validationStatus     String   @map("validation_status")
  validationMethod     String   @map("validation_method")
  validationPhase      String   @map("validation_phase")
  validationUpMs       Int?     @map("validation_up_ms")
  validationDownMs     Int?     @map("validation_down_ms")
  /// [ScenarioRecipeJson]
  fixtureJson          Json     @map("fixture_json") @db.Json
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  scenario          Scenario               @relation("ScenarioRecipeVersionHistory", fields: [scenarioId], references: [id], onDelete: Cascade)
  activeForScenario Scenario?              @relation("ActiveScenarioRecipeVersion")
  snapshot          BranchSnapshot         @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  schemaSnapshot    ScenarioSchemaSnapshot @relation(fields: [schemaSnapshotId], references: [id])
  application       Application            @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([scenarioId, snapshotId])
  @@index([scenarioId])
  @@index([snapshotId])
  @@index([schemaSnapshotId])
  @@index([applicationId])
  @@index([organizationId])
  @@map("scenario_recipe_version")
}

/// Append-only log of every recipe write. `ScenarioRecipeVersion` holds one row per
/// (scenario, snapshot) and is overwritten in place, so it is a pointer to the current recipe
/// rather than a history: on its own it cannot say what a recipe used to be, who changed it, or
/// that two editors raced. One row is written here per mutation, by every write path.
///
/// Never pruned. Recipes are small and edits are rare, so the log is cheap to keep whole.
model ScenarioRecipeEdit {
  id              String  @id @default(cuid())
  scenarioId      String  @map("scenario_id")
  applicationId   String  @map("application_id")
  organizationId  String  @map("organization_id")
  /// The version row this write landed on. Nullable so history outlives the version
  /// itself - a planner re-upload deletes and recreates every version for its snapshot.
  recipeVersionId String? @map("recipe_version_id")
  snapshotId      String  @map("snapshot_id")

  /// The recipe exactly as written, and its fingerprint - enough to restore or diff it.
  fingerprint String
  /// [ScenarioRecipeJson]
  fixtureJson Json                     @map("fixture_json") @db.Json
  source      ScenarioRecipeEditSource
  /// The user who drove the write, when there was one. Absent for the planner upload.
  actorUserId String?                  @map("actor_user_id")
  /// Optional human-readable reason, e.g. the agent's description of what it changed.
  note        String?

  scenario     Scenario     @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  application  Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([scenarioId, createdAt])
  @@index([applicationId])
  @@index([organizationId])
  @@map("scenario_recipe_edit")
}

model ScenarioInstance {
  id            String                 @id @default(cuid())
  applicationId String                 @map("application_id")
  scenarioId    String                 @map("scenario_id")
  status        ScenarioInstanceStatus @default(REQUESTED)

  requestedAt DateTime  @default(now()) @map("requested_at")
  upAt        DateTime? @map("up_at")
  downAt      DateTime? @map("down_at")
  completedAt DateTime? @map("completed_at")
  expiresAt   DateTime? @map("expires_at")

  /// [ScenarioAuth]
  auth              Json?
  /// [ScenarioRefs]
  refs              Json?
  refsToken         String? @map("refs_token")
  /// [ScenarioMetadata]
  metadata          Json?
  /// [ScenarioGeneratedData]
  generatedData     Json?   @map("generated_data")
  /// [ScenarioLastError]
  lastError         Json?   @map("last_error")
  /// [ScenarioResolvedVariables]
  resolvedVariables Json?   @map("resolved_variables")

  deploymentId String?           @map("deployment_id")
  deployment   BranchDeployment? @relation(fields: [deploymentId], references: [id], onDelete: SetNull)

  /// Which recipe this run actually provisioned. `generatedData` records the resolved
  /// payload, but nothing identified the recipe behind it - so a result could silently
  /// describe a recipe that has since been edited. Null when an unstored candidate ran.
  recipeVersionId   String? @map("recipe_version_id")
  /// Fingerprint of the recipe that ran, set for a stored version AND for a candidate,
  /// so a dry run of an unsaved edit is still identifiable.
  recipeFingerprint String? @map("recipe_fingerprint")

  application     Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  scenario        Scenario         @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  webhookCalls    WebhookCall[]
  testGenerations TestGeneration[]
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  organizationId  String           @map("organization_id")
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([organizationId])
  @@index([scenarioId])
  @@map("scenario_instance")
}

model WebhookCall {
  id            String        @id @default(cuid())
  applicationId String        @map("application_id")
  instanceId    String?       @map("instance_id")
  action        WebhookAction

  /// [JsonValue]
  requestBody  Json     @map("request_body")
  /// [JsonValue]
  responseBody Json?    @map("response_body")
  statusCode   Int?     @map("status_code")
  durationMs   Int?     @map("duration_ms")
  error        String?
  createdAt    DateTime @default(now()) @map("created_at")

  application Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  instance    ScenarioInstance? @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([instanceId])
  @@map("webhook_call")
}

// ─── GitHub Integration ────────────────────────────────────────────

enum GitHubInstallationStatus {
  active
  suspended
  deleted

  @@map("github_installation_status")
}

model GitHubInstallation {
  id             String                   @id @default(cuid())
  installationId Int                      @unique @map("installation_id")
  organizationId String                   @unique @map("organization_id")
  accountLogin   String                   @map("account_login")
  accountId      Int                      @map("account_id")
  accountType    String                   @map("account_type")
  status         GitHubInstallationStatus @default(active)
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("github_installation")
}

// Stores GitHub ETags so we can make conditional requests (If-None-Match). An authorized
// 304 Not Modified does not count against the primary rate limit, making revalidation
// near-free. ETags are scoped per page URL and per installation token, so we key on
// (installationId, requestKey). We persist only the ETag, not the body: on a 304 nothing
// changed, so callers keep their existing Postgres cache.
model GitHubRequestEtag {
  installationId Int      @map("installation_id")
  requestKey     String   @map("request_key")
  etag           String
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@id([installationId, requestKey])
  @@map("github_request_etag")
}

// ─── Billing ─────────────────────────────────────────────────────

enum SubscriptionStatus {
  active
  canceled
  past_due
  unpaid
  trialing
  paused
  incomplete
  incomplete_expired

  @@map("subscription_status")
}

enum CreditTransactionType {
  SUBSCRIPTION_GRANT
  SUBSCRIPTION_RESET
  FREE_START_GRANT
  PROMO_GRANT
  TOPUP_PURCHASE
  TOPUP_REFUND
  GENERATION_CONSUMPTION
  GENERATION_REFUND
  RUN_CONSUMPTION
  LLM_PROXY_CONSUMPTION
  PREVIEW_RUNTIME_CONSUMPTION
  VERCEL_OVERAGE_GRANT
  AI_COST_CONSUMPTION
  PREVIEW_BUILD_CONSUMPTION

  @@map("credit_transaction_type")
}

model BillingCustomer {
  id               String  @id @default(cuid())
  organizationId   String  @unique @map("organization_id")
  stripeCustomerId String? @unique @map("stripe_customer_id")
  provider         String  @default("stripe")

  subscriptionId     String?             @map("subscription_id")
  subscriptionStatus SubscriptionStatus? @map("subscription_status")
  priceId            String?             @map("price_id")
  currentPeriodStart DateTime?           @map("current_period_start")
  currentPeriodEnd   DateTime?           @map("current_period_end")
  cancelAtPeriodEnd  Boolean             @default(false) @map("cancel_at_period_end")
  gracePeriodEndsAt  DateTime?           @map("grace_period_ends_at")

  creditBalance             Int     @default(0) @map("credit_balance")
  subscriptionCreditBalance Int     @default(0) @map("subscription_credit_balance")
  autoTopUpEnabled          Boolean @default(false) @map("auto_top_up_enabled")
  autoTopUpThreshold        Int     @default(0) @map("auto_top_up_threshold")
  // How far below zero this org's balance may go before new previewkit deploys/PR analysis runs
  // are blocked - an in-flight PR's jobs (AI calls, builds, running compute) always deduct and
  // never get half-billed, floor-clamped here instead of at a hard zero. Defaults to 0 (today's
  // behavior, unchanged) for every org; raised only via a deliberate admin action
  // (admin.billing.updateCreditFloor), same as BillingPricing's compute rates.
  creditFloor               Int     @default(0) @map("credit_floor")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]

  @@map("billing_customer")
}

model BillingPricing {
  id             String @id @default(cuid())
  organizationId String @unique @map("organization_id")

  creditsPerSubscription       Int @default(1000000) @map("credits_per_subscription")
  creditsPerTopup              Int @default(150000) @map("credits_per_topup")
  creditsFreeStart             Int @default(100000) @map("credits_free_start")
  creditsWebGenerationCost     Int @default(500) @map("credits_web_generation_cost")
  creditsIosGenerationCost     Int @default(700) @map("credits_ios_generation_cost")
  creditsAndroidGenerationCost Int @default(540) @map("credits_android_generation_cost")
  creditsWebRunCost            Int @default(10) @map("credits_web_run_cost")
  creditsIosRunCost            Int @default(200) @map("credits_ios_run_cost")
  creditsAndroidRunCost        Int @default(40) @map("credits_android_run_cost")
  stripeTopupAmountCents       Int @default(10000) @map("stripe_topup_amount_cents")

  // Flat, fleet-uniform previewkit compute-usage rates. Zero until a deliberate go/no-go -
  // deductCreditsForPreviewUsage never charges while both are 0, and enforcement is separately
  // gated by PREVIEWKIT_BILLING_ENABLED + OrganizationSettings.previewkitBillingEnabled. Set via
  // the admin.billing.updateComputePricing action, which can pre-fill from the live AWS-derived
  // ComputePricingReference (converted through this org's creditsPerUsd) but always writes a
  // deliberate, reviewed value - never touched automatically by the pricing-drift cronjob, which
  // only ever writes ComputePricingReference.
  creditsPerVcpuHour     Int @default(0) @map("credits_per_vcpu_hour")
  creditsPerGbMemoryHour Int @default(0) @map("credits_per_gb_memory_hour")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("billing_pricing")
}

// Global (not org-scoped) - what AWS actually charges today for the reference instance behind
// each Karpenter compute pool, in USD. Freely auto-updated by the weekly aws-compute-pricing-drift
// cronjob (packages/billing/src/aws-pricing/resolve-compute-rates.ts) - safe to write without
// review because nothing reads this for billing directly. It only ever informs a human decision:
// admin.billing.updateComputePricing converts this (through an org's creditsPerUsd) into a
// suggested credits rate for that org to review and apply to its own BillingPricing row.
model ComputePricingReference {
  // The compute pool this reference describes - "buildkit" | "previewkit" (see
  // REFERENCE_COMPUTE_POOLS in packages/billing/src/aws-pricing/aws-instance-pricing.ts).
  pool String @id

  usdPerVcpuHour Float @map("usd_per_vcpu_hour")
  usdPerGbHour   Float @map("usd_per_gb_hour")

  // Set only for a spot-eligible pool (buildkit) - the real spot/on-demand split its recent
  // builds actually got (PreviewkitAppBuildUsage.capacityType), used to blend the rate above.
  // Null for an on-demand-only pool (previewkit), which has nothing to blend.
  spotFraction Float? @map("spot_fraction")
  sampleSize   Int?   @map("sample_size")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("compute_pricing_reference")
}

model OrganizationSettings {
  id             String @id @default(cuid())
  organizationId String @unique @map("organization_id")

  previewkitBuildDraft   Boolean @default(false) @map("previewkit_build_draft")
  previewkitFilterBranch String? @map("previewkit_filter_branch")

  // VESTIGIAL - no code reads this. Analysis is the only PR-analysis pipeline, so there is no longer a per-org
  // choice to express. Kept for one release because a rolling deploy has old pods still selecting the column;
  // drop it in the follow-up that removes the diffs workflow. The values left in the 4 existing rows mean nothing.
  analysisEnabled Boolean @default(false) @map("analysis_enabled")

  // Whether the Autonoma merge gate is active for this org: post the `Autonoma` check on every PR (any base
  // branch), map the authoritative verdict to its conclusion, require the check across all branches via a repo
  // ruleset, and honor the Skip button. Off by default - enabled per trusted org, never fleet-wide by flag.
  // Additionally gated by the global MERGE_GATE_ENABLED kill switch.
  mergeGateEnabled Boolean @default(false) @map("merge_gate_enabled")

  // Whether this org is migrated to activation: when on, an analysis run never starts on its own - not on PR
  // open/synchronize, not when a preview goes ready - and begins only when someone explicitly asks (a `/start
  // analysis` comment). Off by default.
  activationEnabled Boolean @default(false) @map("activation_enabled")

  // Whether the base-trunk analysis gate is enforced for this org: when on, a PR is analyzed only if its base is
  // the app's trunk (MainBranchInfo.githubRef); an off-trunk PR - a stack, or an internal integration branch - is
  // skipped. Off by default (a PR against ANY base is analyzed), enabled per org once its PR workflow is known to
  // merge into the trunk. Applies to both the diffs `/trigger` path and the previewkit webhook path.
  enforceBaseTrunkGate Boolean @default(false) @map("enforce_base_trunk_gate")

  // Whether previewkit compute-usage billing is enforced for this org: a new deploy/redeploy is declined once the
  // org's combined credit balance is at or below zero (already-running environments are never torn down for it).
  // Gated by the global PREVIEWKIT_BILLING_ENABLED master switch, so a flip is per-org and reversible for the
  // whole fleet. Off by default while usage accrues in shadow mode; enabled per org (autonoma first) once rates
  // are picked from that data.
  previewkitBillingEnabled Boolean @default(false) @map("previewkit_billing_enabled")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

/// An email address that has already had the benefit of the free starting credits, and is therefore
/// not entitled to another.
///
/// Keyed on the address rather than a user id on purpose. The entitlement follows the person, and a
/// user row does not: deleting an account and signing up again mints a new id for the same human,
/// which is the cheapest way to reset a per-user cap. The address survives that.
///
/// Written when a grant is made, and when somebody joins an organization that holds one - so it also
/// covers the expensive version, where one person takes the grant and invites colleagues who each
/// then create their own funded organization.
model FreeStartIneligibility {
  id    String @id @default(cuid())
  /// Normalized: trimmed and lower-cased before writing, so case cannot be used to get a second grant.
  email String @unique

  /// The organizations whose starting grant this address had the benefit of, oldest first. Kept for the
  /// UI, which has to answer "why do I have no credits" with something better than "you don't".
  organizationIds String[] @map("organization_ids")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("free_start_ineligibility")
}

model CreditTransaction {
  id             String                @id @default(cuid())
  organizationId String                @map("organization_id")
  type           CreditTransactionType
  amount         Int
  balanceAfter   Int                   @map("balance_after")

  generationId          String? @map("generation_id")
  runId                 String? @unique @map("run_id")
  stripePaymentIntentId String? @unique @map("stripe_payment_intent_id")
  stripeInvoiceId       String? @unique @map("stripe_invoice_id")
  stripeRefundId        String? @unique @map("stripe_refund_id")
  promoRedemptionId     String? @unique @map("promo_redemption_id")
  usageWindowId         String? @unique @map("usage_window_id")
  aiCostRecordId        String? @unique @map("ai_cost_record_id")
  previewkitAppBuildId  String? @unique @map("previewkit_app_build_id")

  createdAt DateTime @default(now()) @map("created_at")

  billingCustomer BillingCustomer         @relation(fields: [organizationId], references: [organizationId], onDelete: Cascade)
  promoRedemption BillingPromoRedemption? @relation(fields: [promoRedemptionId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  // Backs the per-type aggregate in getBillingStatus (e.g. all-time LLM_PROXY_CONSUMPTION).
  @@index([organizationId, type])
  @@map("credit_transaction")
}

model BillingPromoCode {
  id String @id @default(cuid())

  code         String  @unique
  description  String?
  grantCredits Int     @map("grant_credits")

  maxRedemptions Int? @map("max_redemptions")
  redeemedCount  Int  @default(0) @map("redeemed_count")

  startsAt DateTime? @map("starts_at")
  endsAt   DateTime? @map("ends_at")
  isActive Boolean   @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  redemptions BillingPromoRedemption[]

  @@map("billing_promo_code")
}

model BillingPromoRedemption {
  id String @id @default(cuid())

  promoCodeId    String @map("promo_code_id")
  organizationId String @map("organization_id")

  promoCode         BillingPromoCode   @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creditTransaction CreditTransaction?

  @@unique([promoCodeId, organizationId])
  @@index([promoCodeId])
  @@index([organizationId])
  @@map("billing_promo_redemption")
}

// ─── Previewkit ─────────────────────────────────────────────────────

enum PreviewkitStatus {
  pending
  building
  deploying
  ready
  failed
  // A deploy cancelled because a newer commit superseded it. Written to the
  // superseded build row only; the environment row stays owned by the newest
  // run, so this value never lands on PreviewkitEnvironment.
  superseded
  torn_down

  @@map("previewkit_status")
}

enum PreviewkitAppBuildStatus {
  success
  failed

  @@map("previewkit_app_build_status")
}

// How a dependency repo's branch is derived from the PR's branch, on
// PreviewkitConfig. Absent behaves as same_branch_name.
enum PreviewkitBranchConvention {
  same_branch_name
  regex
  manual

  @@map("previewkit_branch_convention")
}

enum PreviewkitHookGroup {
  pre_deploy
  post_deploy

  @@map("previewkit_hook_group")
}

enum PreviewkitSetupTaskFrequency {
  on_create
  every_commit

  @@map("previewkit_setup_task_frequency")
}

// Full per-app lifecycle status, tracked on PreviewkitAppInstance from the
// moment the resolved config names the apps (moment 0). The happy path is
// pending -> building -> built -> deploying -> ready. `build_failed` /
// `deploy_failed` are terminal failures (reason in `error`); `skipped` means
// an upstream build failure meant the deploy was never attempted.
enum PreviewkitAppStatus {
  pending
  building
  built
  deploying
  ready
  build_failed
  deploy_failed
  skipped

  @@map("previewkit_app_status")
}

model PreviewkitEnvironment {
  id String @id @default(cuid())

  // Identity - matches the K8s namespace naming: {owner}-{repo}-{N}-{hash}
  namespace          String @unique
  repoFullName       String @map("repo_full_name")
  prNumber           Int    @map("pr_number")
  headSha            String @map("head_sha")
  headRef            String @map("head_ref")
  githubRepositoryId Int?   @map("github_repository_id")

  status PreviewkitStatus @default(pending)
  phase  String?
  error  String?

  // GitHub PR comment Previewkit updates through the lifecycle
  commentId String? @map("comment_id")

  /// ![Record<string, string>]
  urls Json @default("{}")

  bypassToken String? @map("bypass_token")

  // The effective config for the latest deploy attempt: the Application's full
  // topology document with each dependency repo's deployed commit stamped onto
  // its `repositories[]` entry (`sha`). The summary + readiness views project
  // it for display and failure diagnostics - there is no separate manifest
  // column. Overwritten on each deploy once the config resolves. Not read on
  // redeploy - that re-resolves the Application's current config.
  /// ![object]
  resolvedConfig Json? @map("resolved_config")

  deployedAt DateTime? @map("deployed_at")
  tornDownAt DateTime? @map("torn_down_at")

  // Compute-usage metering checkpoint: the exclusive end of the last closed,
  // billed PreviewkitUsageWindow. Null means metering hasn't started yet (or
  // this environment predates the meter) - the sweep starts from deployedAt.
  meteredAt DateTime? @map("metered_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // The autonoma Branch this environment's PR maps to. Made explicit here rather than reconstructed at runtime
  // from (githubRepositoryId, prNumber). Nullable: environments for repos with no onboarded Application (and
  // the main-branch env 0) have no branch. SetNull so deleting a branch unlinks the env instead of deleting it.
  branchId String? @unique @map("branch_id")
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  builds       PreviewkitBuild[]
  appInstances PreviewkitAppInstance[]
  usageWindows PreviewkitUsageWindow[]

  @@unique([repoFullName, prNumber])
  @@index([organizationId, status])
  @@map("previewkit_environment")
}

enum GitHubPrCommentKind {
  preview
  investigation
  analysis
  // The single Autonoma PR comment - preview status + analysis - owned by the analysis run workflow. Supersedes the
  // separate `preview` and `analysis` comments, which the workflow deletes on this comment's first post.
  pr
  credits

  @@map("github_pr_comment_kind")
}

model GitHubPrComment {
  id           String              @id @default(cuid())
  repoFullName String              @map("repo_full_name")
  prNumber     Int                 @map("pr_number")
  kind         GitHubPrCommentKind
  commentId    String?             @map("comment_id")
  headSha      String?             @map("head_sha")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([repoFullName, prNumber, kind])
  @@map("github_pr_comment")
}

// The `Autonoma` merge-gate check run posted on a PR.
model GitHubCheckRun {
  id           String  @id @default(cuid())
  repoFullName String  @map("repo_full_name")
  prNumber     Int     @map("pr_number")
  headSha      String  @map("head_sha")
  checkRunId   String  @map("check_run_id") // GitHub's numeric check-run id, stored as string
  conclusion   String? // last conclusion we set (in_progress while pending, then failure/success/neutral)

  // The activation record for this head: who/what asked for the run (source is one of ANALYSIS_RUN_SOURCE in
  // @autonoma/github/check; actor is the requester's login where one exists). Null until a run is requested - an
  // un-requested PR's check stays a completed `neutral` "no analysis requested" state with no activation.
  activationSource String?   @map("activation_source")
  activatedByLogin String?   @map("activated_by_login")
  activatedAt      DateTime? @map("activated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([repoFullName, headSha])
  @@index([repoFullName, prNumber])
  @@map("github_check_run")
}

// A first-class record of a developer clicking the merge-gate Skip button. Snapshots the open bugs at skip time
// (count + finding keys + the snapshot whose verdict was skipped).
model SkipRecord {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  repoFullName   String   @map("repo_full_name")
  prNumber       Int      @map("pr_number")
  headSha        String   @map("head_sha")
  snapshotId     String?  @map("snapshot_id") // the snapshot whose verdict was skipped
  actorLogin     String   @map("actor_login") // login of the developer who ran /autonoma-skip
  openBugCount   Int      @map("open_bug_count")
  openFindingIds Json     @map("open_finding_ids") // findingKeys open at skip time
  reason         String? // optional free-text reason from the /autonoma-skip comment
  skipCommentId  String?  @map("skip_comment_id") // id of the standalone attribution comment
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([repoFullName, prNumber])
  @@index([repoFullName, headSha])
  @@map("skip_record")
}

// One person who contributed to a PR/branch: a commit author, a `Co-authored-by:` co-author, or the opener.
// Stickiness is a per-developer habit, so a branch's outcome must be attributable to ALL its authors, not
// just the PR opener. Refreshed on pull_request open/synchronize/close, keyed by (repo, PR, contributorKey).
model BranchContributor {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  repoFullName   String   @map("repo_full_name")
  prNumber       Int      @map("pr_number")
  branchId       String?  @map("branch_id")
  login          String?
  displayName    String?  @map("display_name")
  email          String?
  isOpener       Boolean  @default(false) @map("is_opener")
  contributorKey String   @map("contributor_key")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([repoFullName, prNumber, contributorKey])
  @@index([organizationId, createdAt])
  @@index([repoFullName, prNumber])
  @@index([login])
  @@map("branch_contributor")
}

// The per-bug outcome of a merged PR: for every client bug we flagged, did the developer fix it before merging?
// This is the stickiness "did it help?" measurement, read (never computed) from the branch-scoped AnalysisIssue
// status at merge time. `resolved` -> fixed_before_merge, `open` -> merged_with_bug.
enum BugFixOutcomeKind {
  fixed_before_merge // the bug's AnalysisIssue was resolved by the last run before merge
  merged_with_bug // the bug's AnalysisIssue was still open at merge time
  skipped // the PR was skipped (a SkipRecord exists) - not counted as fixed or unfixed
  unknown // no analysis assessed this PR (never ran, or the last run did not finish)

  @@map("bug_fix_outcome_kind")
}

// One BugFixOutcome row per client bug the analysis flagged on a merged PR.
model BugFixOutcome {
  id             String            @id @default(cuid())
  organizationId String            @map("organization_id")
  repoFullName   String            @map("repo_full_name")
  prNumber       Int               @map("pr_number")
  branchId       String            @map("branch_id")
  issueId        String?           @map("issue_id")
  outcome        BugFixOutcomeKind
  severity       String?
  mergedAt       DateTime?         @map("merged_at")
  mergedByLogin  String?           @map("merged_by_login")
  createdAt      DateTime          @default(now()) @map("created_at")

  @@unique([branchId, issueId])
  @@index([organizationId, createdAt])
  @@index([repoFullName, prNumber])
  @@map("bug_fix_outcome")
}

// Which channel surfaced a false-positive candidate.
enum FalsePositiveCandidateSource {
  mcp_client_agent // unwritten: the debug MCP tool that recorded it is gone, and no row ever carried this value
  skip_reason // inferred from an FP-indicating `/autonoma-skip` reason

  @@map("false_positive_candidate_source")
}

// A "false-positive candidate": a signal that one finding (scoped to the snapshot
// whose report surfaced it) may be a false positive. Tracking data only - existence
// of a row means "candidate", there is no confirmed state, and NOTHING in the merge
// gate reads this table (it never unblocks a check or hides a finding). It is the
// seed of the FP eval set, fed by two channels (see FalsePositiveCandidateSource):
// the debug MCP tool and an FP-indicating skip reason. A finding is identified by
// (snapshotId, findingKey) because findings are recreated per push, so a findingKey
// is stable only within one snapshot's report.
model FindingFalsePositiveCandidate {
  id             String                       @id @default(cuid())
  organizationId String                       @map("organization_id")
  repoFullName   String                       @map("repo_full_name")
  prNumber       Int                          @map("pr_number")
  snapshotId     String                       @map("snapshot_id")
  findingKey     String                       @map("finding_key")
  source         FalsePositiveCandidateSource
  // Who flagged it: the /autonoma-skip GitHub actor login, or the MCP caller's user id. Identity space varies by source.
  reportedBy     String                       @map("reported_by")
  reason         String? // free text: the MCP `reason?`, or the raw skip reason
  createdAt      DateTime                     @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([repoFullName, prNumber])
  @@map("finding_false_positive_candidate")
}

model PreviewkitBuild {
  id String @id @default(cuid())

  environmentId String                @map("environment_id")
  environment   PreviewkitEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  headSha    String           @map("head_sha")
  status     PreviewkitStatus @default(pending)
  error      String?
  startedAt  DateTime         @default(now()) @map("started_at")
  finishedAt DateTime?        @map("finished_at")
  durationMs Int?             @map("duration_ms")

  appBuilds PreviewkitAppBuild[]

  // One build row per (environment, commit). Makes recordBuildFinished an
  // idempotent upsert so a Temporal activity retry updates the existing row
  // instead of inserting a duplicate.
  @@unique([environmentId, headSha])
  @@index([environmentId, startedAt])
  @@map("previewkit_build")
}

// One row per closed, wall-clock-aligned 15-minute compute-usage window for a
// running environment. Written by the usage-meter sweep from AMP (Amazon
// Managed Prometheus) cAdvisor series, scoped to the whole K8s namespace -
// customer app pods, provisioned databases, and hook Jobs all count. Rows keep
// the raw measured inputs (not a precomputed credit amount) so bills stay
// auditable and recomputable if BillingPricing rates change later.
model PreviewkitUsageWindow {
  id String @id @default(cuid())

  environmentId String                @map("environment_id")
  environment   PreviewkitEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  // Denormalized from environment.organizationId - deliberately, so the sweep
  // and billing queries never need to join through PreviewkitEnvironment.
  // Stays correct because it's set once at insert time from the same row the
  // sweep already read to get environmentId, and an environment's
  // organizationId never changes after creation.
  organizationId String @map("organization_id")

  windowStart DateTime @map("window_start")
  windowEnd   DateTime @map("window_end")

  // Zero means zero: a window whose namespace had no samples records the same
  // 0/0 as a genuinely idle one, and nothing distinguishes them afterwards.
  vcpuSeconds Float @map("vcpu_seconds")
  gbSeconds   Float @map("gb_seconds")

  createdAt DateTime @default(now()) @map("created_at")

  // One row per (environment, window). Makes the sweep an idempotent upsert -
  // a crashed-and-rerun sweep for a window it already closed is a no-op.
  @@unique([environmentId, windowStart])
  @@index([organizationId])
  @@map("previewkit_usage_window")
}

// One row per PreviewkitAppBuild's compute usage. Buildkit jobs can't be measured
// the way PreviewkitUsageWindow measures a running environment (cAdvisor doesn't
// scrape buildkit nodes at all, and buildkitd escapes its container cgroup to
// host-root anyway - see deployment/prometheus-agent/production.yaml). Instead this
// derives vcpuSeconds/gbSeconds from the app build's own durationMs times the known,
// fixed shape of its dedicated node (every buildkit Job gets its own node via hard
// anti-affinity - see deployment/karpenter/node-pool/buildkit.yaml). Rows keep the
// raw derived inputs, not a precomputed credit amount, same as PreviewkitUsageWindow.
model PreviewkitAppBuildUsage {
  id String @id @default(cuid())

  appBuildId String             @unique @map("app_build_id")
  appBuild   PreviewkitAppBuild @relation(fields: [appBuildId], references: [id], onDelete: Cascade)

  // Denormalized from the owning environment's organizationId, same rationale as
  // PreviewkitUsageWindow.organizationId.
  organizationId String @map("organization_id")

  vcpuSeconds Float @map("vcpu_seconds")
  gbSeconds   Float @map("gb_seconds")

  // The real EC2 instance type/capacity type Karpenter provisioned for this build's dedicated
  // buildkit node (e.g. "m7i.xlarge", "spot"), read from the node's labels once the build pod is
  // scheduled - see BuildKitJobManager.provision(). Best-effort: undefined when the build never
  // reached that point (e.g. a provisioning failure) or the node lookup itself failed; a missing
  // value falls back to a pool-wide reference rate rather than blocking usage recording.
  instanceType String? @map("instance_type")
  capacityType String? @map("capacity_type")

  // Real USD cost of THIS build - the exact instance/capacity type it landed on, priced at
  // spot's live price (spot builds, fetched right as the build finishes) or the stable on-demand
  // price otherwise. Deliberately separate from BillingPricing's admin-set customer rate: this
  // answers "what did this build actually cost us", not "what do we charge for it". Undefined
  // when instanceType/capacityType weren't captured, the observed instance type isn't one the
  // pinned AWS SDK recognizes yet, or the pricing call itself failed - never blocks usage
  // recording, see meterAppBuilds in apps/previewkit/src/db/index.ts.
  realCostUsdMicrodollars Int? @map("real_cost_usd_microdollars")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("previewkit_app_build_usage")
}

// One row per app built within a PreviewkitBuild. Normalized out of what used
// to be the `app_builds` JSON column so each app's outcome is a typed,
// queryable row. Apps build independently, so one app's failure leaves the
// others' rows intact. `imageTag` is set on success; `error` on failure;
// `logUrl` is a legacy column from the retired S3 log archive - kept for
// historic rows, never written anymore (build logs are served from Loki).
model PreviewkitAppBuild {
  id String @id @default(cuid())

  buildId String          @map("build_id")
  build   PreviewkitBuild @relation(fields: [buildId], references: [id], onDelete: Cascade)

  appName    String                   @map("app_name")
  appId      String                   @map("app_id")
  app        PreviewkitApp            @relation(fields: [appId], references: [id], onDelete: Cascade)
  status     PreviewkitAppBuildStatus
  imageTag   String?                  @map("image_tag")
  durationMs Int                      @map("duration_ms")
  logUrl     String?                  @map("log_url")
  error      String?
  // Build strategy that produced the image: "node" | "docker-image" | "unknown".
  // Stored as text (not an enum) because the value has a hyphen and the reader
  // treats it loosely when picking a service icon.
  runtime    String?

  createdAt DateTime @default(now()) @map("created_at")

  usage PreviewkitAppBuildUsage?

  @@unique([buildId, appName])
  @@index([appId])
  @@map("previewkit_app_build")
}

// One row per app per environment - the per-app lifecycle record and the
// source of truth for an app's status. Created at moment 0 (as `pending`, as
// soon as the resolved config names the apps) and transitioned through build
// and deploy, so a built-but-undeployed app (e.g. one that failed readiness
// while its siblings came up) is a distinct, queryable row rather than an
// inferred absence. `imageTag` is null until the build succeeds; `error`
// carries the reason for a `build_failed` / `deploy_failed` status.
model PreviewkitAppInstance {
  id String @id @default(cuid())

  environmentId String                @map("environment_id")
  environment   PreviewkitEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  appName  String              @map("app_name")
  appId    String              @map("app_id")
  app      PreviewkitApp       @relation(fields: [appId], references: [id], onDelete: Cascade)
  status   PreviewkitAppStatus @default(pending)
  imageTag String?             @map("image_tag")
  error    String?
  url      String?
  port     Int

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([environmentId, appName])
  @@index([appId])
  @@map("previewkit_app_instance")
}

// One version of the key that encrypts previewkit secret values. `wrap` is the
// key material sealed by the previewkit secrets CMK - never the plaintext key,
// which exists only in memory, only in a process that needs it, and never in
// configuration. These rows are therefore inert without `kms:Decrypt`.
//
// One version is shared by every secret value (not one per bundle). Each stored
// envelope names the `id` it was sealed with, so rotation is: mint a new row as
// primary, let old envelopes keep resolving to their own version, re-encrypt in
// the background, leave the retired row in place. Retired rows are never
// deleted: the row reserves its `id`, which must stay unambiguous forever
// because envelopes name one. Because every process resolves keys through this
// table rather than through its own environment, a rotation needs no coordinated
// rollout.
model PreviewkitEncryptionKey {
  id      String  @id
  /// The sealed key, never the plaintext - see `unwrap` in `@autonoma/secrets`.
  wrap    Bytes
  // Exactly one row should be primary; `mintSecretKey` demotes the others in the
  // same transaction. Reads never trust more than the newest primary. Mapped to
  // `is_primary` because `primary` is a reserved word in Postgres - Prisma quotes
  // identifiers, but hand-written SQL against it would not have to.
  primary Boolean @default(false) @map("is_primary")

  values PreviewkitSecret[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([primary])
  @@map("previewkit_encryption_key")
}

// One secret an app's preview runs with: an environment variable and its sealed
// value. There is no bundle row - a "bundle" is just the set of rows sharing an
// appId, so an app with no secrets has no rows rather than an empty parent.
model PreviewkitSecret {
  id              String @id @default(cuid())
  /// The app this value belongs to, and the only thing that identifies it.
  /// Deleting the app takes this row with it.
  appId           String @map("app_id")
  /// The environment variable name, e.g. DATABASE_URL. Not a cryptographic key.
  key             String
  envelope        String
  /// Which encryption key sealed `envelope`. Restrict, not Cascade: a key must
  /// not be deletable while any value still needs it to be readable.
  encryptionKeyId String @map("encryption_key_id")
  /// Non-reversible SHA-256 prefix, for equality checks without the value.
  fingerprint     String
  maskedLength    Int    @map("masked_length")

  app           PreviewkitApp           @relation(fields: [appId], references: [id], onDelete: Cascade)
  encryptionKey PreviewkitEncryptionKey @relation(fields: [encryptionKeyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([appId, key])
  @@index([encryptionKeyId])
  @@map("previewkit_secret")
}

// One encrypted value in an app's secret bundle. `envelope` is SecretCipher
// output (`v1.<generation>.<base64>`); the plaintext is never stored, and it
// only decrypts under the scope of this exact row, so a ciphertext moved to
// another application or key fails rather than leaking.
//
// `fingerprint` and `maskedLength` are derived at seal time precisely so listing
// a bundle - which needs key names and a "does this match what I hold?" check,
// not values - never has to unwrap a key or decrypt anything.

// An Application's preview config - latest-only, one row per Application (no
// revision history; saving replaces the topology in place).
//
// Stored as rows, never as a document: the columns here plus the child tables
// below ARE the config, and readers compose a document from them
// (`documentFromPreviewkitConfigRows`) to validate at their own boundary. The
// polymorphic leaves an app's build format churns through - `build`,
// `blueprint`, a service's `options`, a setup task's `location` - stay JSON on
// their row, so that churn never costs a migration.
//
// There is no stored `schemaVersion`: `previewConfigSchema` is the
// compatibility layer (it strips retired fields and defaults their
// replacements), and the codec emits `version: 2` rather than storing it.
model PreviewkitConfig {
  id            String      @id @default(cuid())
  applicationId String      @unique @map("application_id")
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // The topology, normalized. Readers compose a config document from these rows
  // via `documentFromPreviewkitConfigRows` and validate it at their own
  // boundary; `version: 2` is emitted by that codec rather than stored.
  domain   String?
  registry String?

  // branch_convention, flattened: a 0..1 discriminated value, so columns rather
  // than a child table. pattern/replacement are set only for `regex`.
  branchConventionType        PreviewkitBranchConvention? @map("branch_convention_type")
  branchConventionPattern     String?                     @map("branch_convention_pattern")
  branchConventionReplacement String?                     @map("branch_convention_replacement")

  repositories PreviewkitConfigRepository[]
  apps         PreviewkitApp[]
  services     PreviewkitConfigService[]
  hooks        PreviewkitConfigHook[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("previewkit_config")
}

// Per-repository deploy settings. An entry never ADDS a repo to the topology
// (that set is derived from apps[].repository) - it overrides defaults for one
// and receives deploy provenance in `sha`.
model PreviewkitConfigRepository {
  id       String           @id @default(cuid())
  configId String           @map("config_id")
  config   PreviewkitConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  position Int

  repo           String
  fallbackBranch String  @map("fallback_branch")
  sha            String?

  @@unique([configId, position])
  @@index([configId])
  @@map("previewkit_config_repository")
}

// One app in the topology. `build` and `blueprint` stay JSON: they are
// polymorphic build-strategy blocks whose format churns independently of the
// topology, and nothing queries inside them.
/// An app in a preview topology, and the thing everything about that app hangs
/// off. Durable across saves: `upsertConfig` diffs rather than replacing, so the
/// id is stable and the secrets, instances and builds pointing at it survive an
/// edit. Removing the app from the topology deletes the row, and its children
/// with it.
model PreviewkitApp {
  id       String           @id @default(cuid())
  configId String           @map("config_id")
  config   PreviewkitConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  position Int

  name         String
  repository   String
  path         String
  buildContext String?  @map("build_context")
  dockerfile   String?
  /// ![PreviewkitStoredBuild]
  build        Json?
  /// ![PreviewkitBlueprint]
  blueprint    Json?
  buildSecrets String[] @default([]) @map("build_secrets")
  port         Int
  command      String?
  healthCheck  String?  @map("health_check")

  // Tri-state: the config schema allows an explicit `false`, so null means the
  // field is absent rather than false.
  primary        Boolean?
  sdkImplemented Boolean? @map("sdk_implemented")

  // Where this app mounts the SDK handler, when it is not the conventional
  // path. Absent is NOT the same as the convention: it means the config has no
  // opinion, which is what keeps a hand-registered endpoint from being rewritten.
  sdkPath String? @map("sdk_path")

  /// A request with no limit: capping CPU throttles a container's startup burst.
  resourcesCpu           String  @map("resources_cpu")
  /// Both the request and the limit - what a container is promised is what it may use.
  resourcesMemory        String  @default("1Gi") @map("resources_memory")
  /// Vestigial. Superseded by `resourcesMemory`; nothing reads or writes them.
  /// Nullable so the writers could stop filling them in before the columns come
  /// off, which the next migration does.
  resourcesMemoryRequest String? @map("resources_memory_request")
  resourcesMemoryLimit   String? @map("resources_memory_limit")

  dependsOn String[] @default([]) @map("depends_on")

  connections PreviewkitConfigConnection[]
  secrets     PreviewkitSecret[]
  instances   PreviewkitAppInstance[]
  builds      PreviewkitAppBuild[]

  @@unique([configId, name])
  @@index([configId, position])
  @@index([configId])
  @@map("previewkit_app")
}

// A runtime env var wired to the topology via a `{{name.property}}` template.
// Deliberately NOT unique on (appId, key): a duplicate key is a semantic-validator
// error, not a schema-parse one, so a document stored before that rule existed can
// legally carry one and a constraint here would fail its backfill.
model PreviewkitConfigConnection {
  id       String        @id @default(cuid())
  appId    String        @map("app_id")
  app      PreviewkitApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  position Int

  key       String
  value     String
  buildTime Boolean @map("build_time")

  @@unique([appId, position])
  @@index([appId])
  @@map("previewkit_config_connection")
}

// A recipe-provisioned service (database, queue, ...). `options` stays JSON:
// the knobs are recipe-specific and validated per-recipe downstream.
//
// NOTE: this model's client accessor is `db.previewkitConfigService`, which reads
// close to the API's own `PreviewkitConfigService` class. No file needs both today;
// alias on import if one ever does.
model PreviewkitConfigService {
  id       String           @id @default(cuid())
  configId String           @map("config_id")
  config   PreviewkitConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  position Int

  name    String
  recipe  String
  version String?
  /// ![PreviewkitServiceOptions]
  options Json

  /// A request with no limit: capping CPU throttles a container's startup burst.
  resourcesCpu           String  @map("resources_cpu")
  /// Both the request and the limit - what a container is promised is what it may use.
  resourcesMemory        String  @default("1Gi") @map("resources_memory")
  /// Vestigial. Superseded by `resourcesMemory`; nothing reads or writes them.
  /// Nullable so the writers could stop filling them in before the columns come
  /// off, which the next migration does.
  resourcesMemoryRequest String? @map("resources_memory_request")
  resourcesMemoryLimit   String? @map("resources_memory_limit")

  s3  Boolean?
  sqs Boolean?
  sns Boolean?

  setupTasks PreviewkitConfigSetupTask[]

  @@unique([configId, position])
  @@unique([configId, name])
  @@index([configId])
  @@map("previewkit_config_service")
}

// A database setup command (schema, seed, migration). `location` stays JSON: it
// is a discriminated union the runner does not fully honor yet.
model PreviewkitConfigSetupTask {
  id        String                  @id @default(cuid())
  serviceId String                  @map("service_id")
  service   PreviewkitConfigService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  position  Int

  command   String
  frequency PreviewkitSetupTaskFrequency
  /// ![PreviewkitSetupTaskLocation]
  location  Json

  @@unique([serviceId, position])
  @@index([serviceId])
  @@map("previewkit_config_setup_task")
}

// A pre/post-deploy hook step. `position` is load-bearing: hooks run in order.
model PreviewkitConfigHook {
  id       String              @id @default(cuid())
  configId String              @map("config_id")
  config   PreviewkitConfig    @relation(fields: [configId], references: [id], onDelete: Cascade)
  group    PreviewkitHookGroup @map("hook_group")
  position Int

  app     String
  command String

  @@unique([configId, group, position])
  @@index([configId])
  @@map("previewkit_config_hook")
}

// Per-repo (per-application) activation trigger config. One row per Application; absence means the code
// defaults apply. Under activation an analysis run starts only on
// an explicit trigger; this row configures the two automatic/labelled triggers a repo opts into.
model ApplicationTriggerConfig {
  id            String      @id @default(cuid())
  applicationId String      @unique @map("application_id")
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // Whether marking a PR ready-for-review automatically starts an analysis run.
  // Off by default: under activation nothing runs unless explicitly asked.
  autoRunOnReadyForReview Boolean @default(false) @map("auto_run_on_ready_for_review")

  // The PR label whose addition triggers an analysis run.
  analysisTriggerLabel String @default("autonoma:analyze") @map("analysis_trigger_label")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("application_trigger_config")
}

// ─── Analysis ─────────────────────────────────────────────────────────────────

enum AnalysisJobStatus {
  running
  completed
  failed

  @@map("analysis_job_status")
}

/// The status row for one analysis run - what the snapshot status/badge/history queries read to learn whether a
/// run is in flight. Created `running` by the trigger and flipped `completed`/`failed` by finalize (a
/// supersession marks it terminal). Keyed 1:1 by snapshot, cascade from BranchSnapshot. Health counts still
/// derive from runs; this only tracks the pipeline's own lifecycle.
model AnalysisJob {
  snapshotId String         @id @map("snapshot_id")
  snapshot   BranchSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  status AnalysisJobStatus @default(running)

  failureReason String? @map("failure_reason") @db.Text

  /// The Impact Analysis stage's account of why it selected the tests it did, written when that stage completes -
  /// so the selection reasoning is legible mid-run, before any report exists. The single source of truth the
  /// report read joins. Nullable: absent while the stage is still running, and on a run whose selection produced
  /// no reasoning.
  impactReasoning String? @map("impact_reasoning") @db.Text

  /// A newer analysis request displaced this run before it finished. Recorded rather than inferred: the outcome
  /// that closes the job already discriminates it (`AnalysisRunOutcome.kind`), and reading it back out of
  /// `failureReason`'s prose was a prefix guess that health metrics then counted on. `status` stays `failed` -
  /// the run did not complete - so every status reader keeps its meaning.
  superseded Boolean @default(false)

  /// The run was cancelled because its application was deleted, unlinked, or its org disconnected GitHub, so
  /// nobody wants the result. Like `superseded`, `status` stays `failed` (the run did not complete) and this flag
  /// is the machine-readable discriminator that keeps it out of genuine-failure counts.
  cancelled Boolean @default(false)

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// The run's per-test findings, keyed on the job's snapshot PK. Each Investigator persists its own finding
  /// against the job - which exists from the start of the run - during fan-out; the Reporter later reconciles
  /// them into branch-scoped issues and authors the AnalysisReport.
  findings AnalysisFinding[]

  @@index([organizationId])
  @@map("analysis_job")
}

/// The merged analysis pipeline's rich per-snapshot report, AUTHORED BY THE REPORTER once fan-out completes: the
/// row's mere existence means the Reporter ran to completion (a Reporter failure fails the run, leaving no report).
/// While the run is in flight it has only its AnalysisJob and the findings the Investigators persist. One row per
/// run holds only the report prose the Reporter authored; the run's verdict, counts and coverage-plane summary are
/// DERIVED on read from its findings, and the Impact Analysis reasoning lives on the AnalysisJob. The run's per-test
/// findings live in AnalysisFinding, keyed to the AnalysisJob (not here).
/// Only FKs OUTWARD (snapshot / org, cascade); nothing in the core app FKs into it.
model AnalysisReport {
  snapshotId String         @id @map("snapshot_id")
  snapshot   BranchSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  /// The Reporter's title for the PR as a whole (about eight words), leading the PR page and the GitHub comment.
  /// Authored for every outcome except an open bug, where the deterministic "Autonoma found N bugs in this PR"
  /// stands instead - a bug is the one thing we state as an alarm rather than describe.
  ///
  /// NOT NULL with no default, so a writer that forgets it fails rather than silently persisting '' - which every
  /// reader takes to mean "no authored title". That is what '' means on the reports that predate this column, and
  /// the only thing it means; they are deliberately not backfilled, since a derived title stored here would be
  /// indistinguishable from an authored one. `analysisPrTitle` is the single reader of ''; delete that branch when
  /// no live surface can reach a pre-Reporter report.
  title    String @db.Text
  /// The Reporter's headline for the PR as a whole: 1-3 sentences of plain prose (no headings, no evidence/issue/
  /// finding tokens), stating the CUMULATIVE state of the branch rather than the latest snapshot's counts. The
  /// column is still named `summary` - it held the per-run paragraph before the Reporter took over the headline,
  /// and the rename is a field-level one so no data has to move.
  headline String @map("summary") @db.Text
  /// The run's flow itemization: the branch's last-known verdict per test, clustered by the Reporter into units a
  /// reader recognizes, with every status and owner derived in code from the verdicts each flow cites. A derived
  /// VIEW with no cross-snapshot identity - re-clustered every run, never reconciled against the last one.
  /// [AnalysisFlows]
  flows    Json?

  /// The Reporter agent's holistic, PR-cumulative report prose (Markdown), written at report birth. Its
  /// `evidence:<assetId>` image tokens resolve against `evidenceManifest`.
  reportMarkdown String @map("report_markdown") @db.Text

  /// The assets the Reporter's `reportMarkdown` may embed inline by `evidence:<assetId>` token, derived from the
  /// evidence the Reporter actually fetched (never authored). Display-only blob, resolved to signed URLs on read.
  /// [EvidenceManifest]
  evidenceManifest Json? @map("evidence_manifest")

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("analysis_report")
}

/// One test's investigation within one analysis run - the unit the report, the merge gate and the finding page all
/// mean by "a finding". Exactly one row per `(run, test)`, enforced by the unique key rather than by convention.
///
/// It holds ONLY the facts that describe the test in the run; every fact about a VERDICT lives on
/// AnalysisClassification, because the Investigator classifies a test more than once (a self-heal rewrites the plan
/// and re-runs it on a fresh generation). `currentClassification` is the verdict this run stands behind - readers
/// that ask "what happened to this test" resolve through it, which is what makes a superseded verdict structurally
/// uncountable rather than a filter everyone has to remember.
model AnalysisFinding {
  id               String      @id @default(cuid())
  /// The run this finding belongs to, keyed to the AnalysisJob's snapshot PK. An Investigator persists its finding
  /// against the job (which exists from the start of the run) during fan-out; the Reporter authors the report later
  /// over these findings. `report_snapshot_id` is that shared snapshot PK.
  reportSnapshotId String      @map("report_snapshot_id")
  job              AnalysisJob @relation(fields: [reportSnapshotId], references: [snapshotId], onDelete: Cascade, map: "analysis_finding_job_fkey")

  /// The test this finding is about. A finding outlives neither its test nor its run, so this is a hard FK - the
  /// test's slug and name are read through it and never copied onto the row.
  testCaseId String   @map("test_case_id")
  testCase   TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  /// The verdict this run stands behind: the newest classification. Null in two cases: between the finding's
  /// creation and its first classification (inside the one transaction that writes both), and permanently on a
  /// contained finding - an investigation that crashed before any run could be judged records its `failure` here
  /// and never gets a classification. Readers asking "was this test judged" must treat both a classification and a
  /// `failure` as covering the test.
  currentClassificationId String?                 @unique @map("current_classification_id")
  currentClassification   AnalysisClassification? @relation("CurrentClassification", fields: [currentClassificationId], references: [id], onDelete: SetNull)

  /// Every classification of this test in this run, oldest first - one per run+classify iteration of the
  /// Investigator's self-heal loop.
  classifications AnalysisClassification[] @relation("FindingClassifications")

  /// Whether the test pre-existed (`pre_existing`) or was authored this run (`proposed`) - the data tag that
  /// tells an obsolete-test `delete` apart from an un-establishable proposal.
  origin String?

  /// Why this investigation crashed without judging a run (mirrors `TestGeneration.failure`). Set by the fan-out
  /// parent when the Investigator child died; a finding with a `failure` and no classifications is a contained
  /// investigation, derived from that emptiness rather than stored as a fake classification. A finding can hold
  /// both a `failure` and classifications when the child crashed mid-loop after filing an iteration - the filed
  /// verdict stands and the `failure` records that the loop never finished.
  /// [AnalysisFindingFailure]
  failure Json?

  /// Why Impact Analysis selected this test to investigate (the affected reason, or the new-test rationale). Ridden
  /// onto the finding at persist so the Reporter has the selection provenance per test, not just the run summary.
  selectionReason String? @map("selection_reason") @db.Text

  /// The branch-scoped AnalysisIssue this finding is attributed to, backfilled by the Reporter after it authors
  /// the issues. Nullable - a passing finding has no issue, a coverage-plane finding has one only when the gap is
  /// the reader's to fix (which is how an environment_failure's OWNER is recorded, the PR comment reading its side
  /// off this attribution), and findings written before the Reporter have none; SetNull so deleting an issue
  /// orphans its findings rather than cascading them away.
  issueId String?        @map("issue_id")
  issue   AnalysisIssue? @relation(fields: [issueId], references: [id], onDelete: SetNull)

  /// Back-relation of `AnalysisIssue.resolvedByFinding`; never queried from this side.
  resolvedIssues AnalysisIssue[] @relation("IssueResolvedByFinding")

  createdAt      DateTime     @default(now()) @map("created_at")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([reportSnapshotId, testCaseId])
  @@index([reportSnapshotId])
  @@index([issueId])
  @@index([organizationId])
  /// Indexes the FK's referencing side: without it, every TestCase delete seq-scans this table for the cascade.
  @@index([testCaseId])
  @@map("analysis_finding")
}

/// One run+classify iteration of the Investigator's self-heal loop: the classifier's judgement of ONE generation of
/// one test, with the evidence it judged and the reasoning that produced it. A test that self-heals N times leaves
/// N of these, each pinned to the generation it judged and each with its own conversation - so the intermediate
/// verdict that authored a wrong self-heal stays auditable instead of being overwritten by the pass that followed.
///
/// Superseded iterations are never destroyed and never counted: the report reads `AnalysisFinding
/// .currentClassification`. Note a contained fault (engine_artifact / environment_failure / scenario_issue) is
/// recorded here too, with its category and no verdict fields - no classifier ran, so there is no conversation, no
/// evidence and no trace.
model AnalysisClassification {
  id        String          @id @default(cuid())
  findingId String          @map("finding_id")
  finding   AnalysisFinding @relation("FindingClassifications", fields: [findingId], references: [id], onDelete: Cascade)

  /// Which slot of the self-heal loop this is, 1-based, assigned from the Investigator's own iteration counter
  /// rather than by counting rows - which is what makes filing one idempotent. Contiguous for rows written since a
  /// crashed child's containment moved to `AnalysisFinding.failure`; older rows can hold a containment fault in the
  /// slot past every real iteration.
  number Int

  /// The generation whose run this classification judged. Each iteration runs a fresh generation, so this is what
  /// pins the verdict to the evidence: a `(test, snapshot)` lookup matches every generation the loop went through.
  generationId String         @map("generation_id")
  generation   TestGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)

  /// The AnalysisVerdict this iteration reached (passed/client_bug/engine_artifact/environment_failure/
  /// scenario_issue/plan_mismatch/invalid_test). A superseded self-heal iteration carries `plan_mismatch`, the same
  /// terminal it routes to. Stored as a plain string so an older row (pre-merge `outdated_test`/`bad_test`/`delete`)
  /// still reads.
  category          String
  confidence        String?
  headline          String   @db.Text
  /// What the app SHOULD have done / what it actually did - the classifier's per-category behavior fields that
  /// replace the free-form `whatHappened` (kept for rows written before the expected/actual split).
  expectedBehavior  String?  @map("expected_behavior") @db.Text
  actualBehavior    String?  @map("actual_behavior") @db.Text
  whatHappened      String?  @map("what_happened") @db.Text
  /// The `plan_mismatch` self-heal post-mortem: what the test asserted that was wrong, the rewrite attempted, and
  /// why it still failed. Set only for a `plan_mismatch` verdict.
  planMismatchNote  String?  @map("plan_mismatch_note") @db.Text
  /// The `invalid_test` justification: which impossibility failure mode (nonexistent feature / unexecutable steps /
  /// wrong premise / unrecoverable) and the proof the test cannot be recovered. Set only for an `invalid_test` verdict.
  invalidTestNote   String?  @map("invalid_test_note") @db.Text
  observedAppIssues String?  @map("observed_app_issues") @db.Text
  remediation       String?  @db.Text
  rootCause         String?  @map("root_cause") @db.Text
  falsePositiveRisk String?  @map("false_positive_risk") @db.Text
  runSuccess        Boolean? @map("run_success")
  stepCount         Int?     @map("step_count")

  /// string[] run-step trace and InvestigationRunStep[] structured trace - display blobs, never queried.
  /// [InvestigationRunSteps]
  runSteps Json? @map("run_steps")
  /// [InvestigationRunTrace]
  runTrace Json? @map("run_trace")
  /// [InvestigationEvidenceList]
  evidence Json?

  /// The classifier-CHOSEN key frame (distinct from `generation.finalScreenshot`); `s3://` key, signed on read.
  screenshotKey String? @map("screenshot_key")
  /// Short GIF clip of the failure (client bugs only).
  clipKey       String? @map("clip_key")

  /// `s3://` URL of the classifier's persisted LLM conversation (the reasoning that produced THIS iteration's
  /// verdict), signed on read. Best-effort at write and display-only: absent when the upload failed and on a
  /// contained fault, where no classifier ran. Backs the admin "View classifier reasoning" link.
  conversationUrl String? @map("conversation_url")

  /// Present instead of the verdict fields when the model failed to classify this run.
  error String? @db.Text

  createdAt      DateTime     @default(now()) @map("created_at")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// The finding this classification is the current verdict of, if it is. Back-relation of
  /// `AnalysisFinding.currentClassification`; never queried from this side.
  currentOf AnalysisFinding? @relation("CurrentClassification")

  @@unique([findingId, number])
  @@index([findingId])
  @@index([organizationId, category])
  /// Indexes the FK's referencing side: discarding a snapshot's pending generations happens on every successful
  /// run, and each delete would otherwise seq-scan this table - the fastest-growing of the analysis tables.
  @@index([generationId])
  @@map("analysis_classification")
}

/// A branch/PR-scoped "problem" the Reporter agent authors and evolves ACROSS snapshots - the de-duped, holistic
/// unit above the per-snapshot AnalysisFinding. One issue clusters the findings (across time and across tests) that
/// manifest the same underlying problem; its lifecycle is open/resolved (a carry-forward re-confirms or reopens, a
/// resolve closes it once a covering test re-ran and passed).
///
/// This row holds only the issue's IDENTITY, its LIFECYCLE (`resolvedAt`'s presence - `status` is retired), the
/// current-version pointer, and its covered-finding relation. Every authored CONTENT field (title, kind, severity,
/// the behavior prose, evidence, primary screenshot/test) lives on an append-only AnalysisIssueVersion, exactly as
/// AnalysisFinding holds AnalysisClassification: a carry-forward that re-states the problem mints a NEW version and
/// re-points `currentVersion` rather than overwriting the last one in place, so a weak run can no longer destroy a
/// good narrative authored earlier. A `resolve` is a pure lifecycle transition - it sets `resolvedAt` (plus
/// `resolvedByFinding`/`resolutionNote`) and mints no version. Only FKs OUTWARD (branch / org, cascade); drop-able.
model AnalysisIssue {
  id String @id @default(cuid())

  branchId String @map("branch_id")
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  resolvedAt DateTime? @map("resolved_at")

  /// The passing finding whose run justified resolving this issue - the Reporter names the covering test that
  /// re-ran and passed, resolved to that test's finding on the resolving snapshot. SetNull so deleting the finding
  /// keeps the resolution; null on issues resolved before this was recorded (or by hand).
  resolvedByFindingId String?          @map("resolved_by_finding_id")
  resolvedByFinding   AnalysisFinding? @relation("IssueResolvedByFinding", fields: [resolvedByFindingId], references: [id], onDelete: SetNull)

  /// The Reporter's stated justification for the resolve - why the passing run proves the problem is gone.
  resolutionNote String? @map("resolution_note") @db.Text

  /// Retired: the authored content now lives on AnalysisIssueVersion, read through `currentVersion`. These copies are
  /// kept one deploy - unread and unwritten by the current code - so a rollback to the prior image, whose Reporter
  /// still writes them on `analysisIssue.create`/`update`, meets columns that still exist. Relaxed to nullable so the
  /// current create (which omits them) succeeds. Their DROP, with the `primaryTestCase` relation, rides a follow-up
  /// migration one deploy later (#2580).
  title             String?   @db.Text
  kind              String?
  severity          String?
  expectedBehavior  String?   @map("expected_behavior") @db.Text
  actualBehavior    String?   @map("actual_behavior") @db.Text
  narrativeMarkdown String?   @map("narrative_markdown") @db.Text
  evidenceManifest  Json?     @map("evidence_manifest")
  primaryScreenshot Json?     @map("primary_screenshot")
  suspectedCause    Json?     @map("suspected_cause")
  /// Retired with the content columns above; the live designation is `AnalysisIssueVersion.primaryTestCase`.
  primaryTestCaseId String?   @map("primary_test_case_id")
  primaryTestCase   TestCase? @relation("IssuePrimaryTestCase", fields: [primaryTestCaseId], references: [id], onDelete: SetNull)

  /// The restatement the issue currently stands behind - readers resolve every content field through it. Null only
  /// between the issue's creation and its first version, inside the one transaction that writes both. SetNull rather
  /// than Cascade because a version is only ever deleted with its whole issue, so this never fires in practice.
  currentVersionId String?               @unique @map("current_version_id")
  currentVersion   AnalysisIssueVersion? @relation("CurrentIssueVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  /// Every restatement of this issue, oldest first - one per open/carry-forward run that authored its content.
  versions AnalysisIssueVersion[] @relation("IssueVersions")

  findings AnalysisFinding[]

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// The ledger's hot read is "this branch's open issues", which is `resolvedAt IS NULL`.
  @@index([branchId, resolvedAt])
  @@index([organizationId])
  /// Indexes the FK's referencing side: without it, every AnalysisFinding delete seq-scans this table to SetNull.
  @@index([resolvedByFindingId])
  /// Retired with `primaryTestCaseId`; kept until its follow-up DROP so the FK's referencing side stays indexed.
  @@index([primaryTestCaseId])
  @@map("analysis_issue")
}

/// One authored restatement of an AnalysisIssue - the immutable content the issue stood behind at one point in its
/// life. The Reporter mints one on `open` (the first) and one on every `carry_forward` (which re-states the problem
/// and may reopen it); a `resolve` mints none. The parent's `currentVersion` points at the newest, so the previous
/// narrative/severity/cause survive as an audit trail ("opened at abc123 as critical, restated at def456 as high")
/// instead of being overwritten in place.
///
/// One version per `(issue, snapshot)`: a snapshot's Reporter authors at most one restatement of an issue (a
/// re-settle of a committed snapshot is refused by the report-exists guard, so this never twins). `snapshotId` is
/// nullable and SetNull: the content outlives the run that authored it, and a version backfilled from a
/// pre-versioning issue has no known origin snapshot. Ordered by `createdAt` (not a sequence counter) because
/// different snapshots' Reporters can run concurrently, and a max+1 number would race between them.
model AnalysisIssueVersion {
  id String @id @default(cuid())

  issueId String        @map("issue_id")
  issue   AnalysisIssue @relation("IssueVersions", fields: [issueId], references: [id], onDelete: Cascade)

  /// The snapshot whose Reporter authored this restatement. Null on a backfilled first version (origin unknown);
  /// SetNull so deleting the snapshot keeps the content but forgets which run wrote it.
  snapshotId String?         @map("snapshot_id")
  snapshot   BranchSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)

  title    String @db.Text
  /// The problem's class: "bug" | "environment" | "scenario".
  kind     String
  /// The Reporter's severity call: "critical" | "high" | "medium" | "low".
  severity String

  expectedBehavior  String? @map("expected_behavior") @db.Text
  actualBehavior    String  @map("actual_behavior") @db.Text
  narrativeMarkdown String  @map("narrative_markdown") @db.Text

  /// The assets the narrative may embed inline by `evidence:<assetId>` token, derived from what the Reporter
  /// actually fetched (never authored). Signed to URLs on read.
  /// [EvidenceManifest]
  evidenceManifest Json? @map("evidence_manifest")

  /// The frame the Reporter designated as the clearest view of the problem, resolved to a concrete `s3://` key
  /// (never authored raw). Signed on read; absent falls back to a covering finding's screenshot.
  /// [PrimaryScreenshot]
  primaryScreenshot Json? @map("primary_screenshot")

  /// The covered test the Reporter designated as the clearest REPRODUCTION of the problem. Which test is the
  /// judgement call, so the agent makes it (naming a slug, resolved to this FK at persist); which RUN of it to show
  /// is mechanical, so readers resolve the newest covering finding for this test. Null when the model named a test
  /// it was never shown.
  primaryTestCaseId String?   @map("primary_test_case_id")
  primaryTestCase   TestCase? @relation("IssueVersionPrimaryTestCase", fields: [primaryTestCaseId], references: [id], onDelete: SetNull)

  /// The hedged, code-level suspected cause (explanation + grounded file:line references), validated against the
  /// checked-out repo at author time so a fabricated reference never lands. Absent when nothing was grounded.
  /// [SuspectedCause]
  suspectedCause Json? @map("suspected_cause")

  createdAt      DateTime     @default(now()) @map("created_at")
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// The issue this version is the current restatement of, if it is. Back-relation of
  /// `AnalysisIssue.currentVersion`; never queried from this side.
  currentOf AnalysisIssue? @relation("CurrentIssueVersion")

  @@unique([issueId, snapshotId])
  @@index([issueId])
  @@index([organizationId])
  /// Indexes the FK's referencing side: without it, every TestCase delete seq-scans this table to SetNull.
  @@index([primaryTestCaseId])
  @@index([snapshotId])
  @@map("analysis_issue_version")
}

// Generic durable fixed-window rate-limit counter. One row per limiter key (e.g.
// "onboarding-pair:<userId>"); `count` accumulates within the window that began
// at `windowStartedAt` and resets when the window elapses. Durable (in Postgres,
// not per-pod memory) so the limit holds across the API's replicas and pod
// restarts. Backs RateLimiterService. No TTL: rows persist after their window
// elapses, bounded by the number of distinct keys (user/app counts). If keys ever
// become high-cardinality, add a periodic prune of rows whose windowStartedAt is
// older than the max policy window.
model RateLimitCounter {
  key             String   @id
  windowStartedAt DateTime @map("window_started_at")
  count           Int      @default(0)
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("rate_limit_counter")
}

// ─── Vercel Marketplace ──────────────────────────────────────────────

enum VercelInstallationStatus {
  active
  deleted

  @@map("vercel_installation_status")
}

enum VercelBillingPeriodStatus {
  pending
  active
  completed
  cancelled
  expired

  @@map("vercel_billing_period_status")
}

model VercelBillingPlan {
  id                     String   @id @default(cuid())
  name                   String   @unique
  type                   String   @default("subscription")
  description            String
  scope                  String   @default("installation")
  cost                   String
  initialCharge          String   @default("0") @map("initial_charge")
  preauthorizationAmount Decimal? @map("preauthorization_amount") @db.Decimal(10, 2)
  amountOfRuns           Int      @default(0) @map("amount_of_runs")
  creditsPerCycle        Int      @default(0) @map("credits_per_cycle")
  /// USD price charged per credit consumed beyond `creditsPerCycle` in a billing
  /// period. Undefined means this plan has no pay-per-usage overage - consumption
  /// hard-stops at `creditsPerCycle` same as today, regardless of what an
  /// installation's `maxOverageAmountUsd` is set to.
  overagePricePerCredit  Decimal? @map("overage_price_per_credit") @db.Decimal(10, 6)
  paymentMethodRequired  Boolean  @default(true) @map("payment_method_required")
  details                Json
  isDefault              Boolean  @default(false) @map("is_default")
  level                  Int?
  billingCycleDays       Int      @default(30) @map("billing_cycle_days")

  installations  VercelInstallation[]
  resources      VercelResource[]
  billingPeriods VercelBillingPeriod[]

  @@map("vercel_billing_plan")
}

model VercelInstallation {
  id                   String                   @id @default(cuid())
  vercelInstallationId String                   @unique @map("vercel_installation_id")
  vercelAccountId      String                   @map("vercel_account_id")
  vercelUserId         String                   @map("vercel_user_id")
  organizationId       String                   @map("organization_id")
  userId               String                   @map("user_id")
  status               VercelInstallationStatus @default(active)
  accessTokenEnc       String?                  @map("access_token_enc")
  /// Fixed per-installation secret, generated once at resource-provisioning time and
  /// handed to Vercel as `AUTONOMA_SHARED_SECRET` in the resource's `secrets` response so
  /// Vercel injects it into every connected project itself - the installation's OAuth
  /// token has no `env:write` scope, so writing it via the REST env API is not reliable.
  sharedSecretEnc      String?                  @map("shared_secret_enc")
  billingPlanId        String?                  @map("billing_plan_id")
  /// Customer-configured ceiling, in USD, on pay-per-usage overage charged per
  /// billing period. Undefined means overage is not opted into - consumption
  /// hard-stops at the plan's included `creditsPerCycle`, same as before this
  /// field existed. Only takes effect when the installation's plan also has
  /// `overagePricePerCredit` set.
  maxOverageAmountUsd  Decimal?                 @map("max_overage_amount_usd") @db.Decimal(10, 2)
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  billingPlan    VercelBillingPlan?    @relation(fields: [billingPlanId], references: [id])
  resources      VercelResource[]
  billingPeriods VercelBillingPeriod[]
  invoices       VercelInvoice[]
  projects       VercelProject[]

  @@index([organizationId])
  @@index([userId])
  @@map("vercel_installation")
}

model VercelResource {
  id                   String   @id @default(cuid())
  resourceId           String   @unique @map("resource_id")
  vercelInstallationId String   @map("vercel_installation_id")
  productId            String   @map("product_id")
  name                 String
  status               String   @default("ready")
  billingPlanId        String?  @map("billing_plan_id")
  metadata             Json?
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  installation   VercelInstallation    @relation(fields: [vercelInstallationId], references: [id], onDelete: Cascade)
  billingPlan    VercelBillingPlan?    @relation(fields: [billingPlanId], references: [id])
  billingPeriods VercelBillingPeriod[]

  @@index([vercelInstallationId])
  @@map("vercel_resource")
}

model VercelBillingPeriod {
  id                    String                    @id @default(cuid())
  installationId        String?                   @map("installation_id")
  resourceId            String?                   @map("resource_id")
  planId                String                    @map("plan_id")
  cycleNumber           Int                       @default(1) @map("cycle_number")
  startDate             DateTime                  @default(now()) @map("start_date")
  endDate               DateTime                  @map("end_date")
  status                VercelBillingPeriodStatus @default(pending)
  /// Running total of credits proactively granted this period to keep an
  /// overage-enabled installation running past its plan's included
  /// `creditsPerCycle`, bounded by the installation's `maxOverageAmountUsd`.
  /// Read by the invoicer at period-end to bill the actual overage consumed.
  overageCreditsGranted Int                       @default(0) @map("overage_credits_granted")
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")

  installation VercelInstallation? @relation(fields: [installationId], references: [id], onDelete: Cascade)
  resource     VercelResource?     @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  plan         VercelBillingPlan   @relation(fields: [planId], references: [id])
  invoices     VercelInvoice[]

  @@index([installationId, status])
  @@index([resourceId, status])
  @@index([endDate])
  @@map("vercel_billing_period")
}

model VercelInvoice {
  id              String    @id @default(cuid())
  vercelInvoiceId String    @unique @map("vercel_invoice_id")
  billingPeriodId String    @map("billing_period_id")
  installationId  String    @map("installation_id")
  amount          String
  status          String    @default("pending")
  createdAt       DateTime  @default(now()) @map("created_at")
  paidAt          DateTime? @map("paid_at")

  billingPeriod VercelBillingPeriod @relation(fields: [billingPeriodId], references: [id], onDelete: Cascade)
  installation  VercelInstallation  @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@index([billingPeriodId])
  @@index([installationId])
  @@index([vercelInvoiceId])
  @@index([status])
  @@map("vercel_invoice")
}

model VercelProject {
  id                        String   @id @default(cuid())
  vercelProjectId           String   @map("vercel_project_id")
  vercelInstallationId      String   @map("vercel_installation_id")
  name                      String
  productionUrl             String?  @map("production_url")
  githubRepositoryId        Int?     @map("github_repository_id")
  protectionBypassSecretEnc String?  @map("protection_bypass_secret_enc")
  vercelCheckId             String?  @map("vercel_check_id")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  installation VercelInstallation       @relation(fields: [vercelInstallationId], references: [id], onDelete: Cascade)
  connection   VercelProjectConnection?

  @@unique([vercelProjectId, vercelInstallationId])
  @@index([vercelInstallationId])
  @@map("vercel_project")
}

model VercelProjectConnection {
  id            String   @id @default(cuid())
  projectId     String   @unique @map("project_id")
  applicationId String   @map("application_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  project           VercelProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  application       Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  vercelDeployments VercelDeployment[]

  @@index([applicationId])
  @@map("vercel_project_connection")
}

model VercelDeployment {
  id                  String   @id @default(cuid())
  vercelDeploymentId  String   @unique @map("vercel_deployment_id")
  vercelCheckRunId    String   @map("vercel_check_run_id")
  projectConnectionId String   @map("project_connection_id")
  branchSnapshotId    String?  @map("branch_snapshot_id")
  createdAt           DateTime @default(now()) @map("created_at")

  projectConnection VercelProjectConnection @relation(fields: [projectConnectionId], references: [id], onDelete: Cascade)
  branchSnapshot    BranchSnapshot?         @relation(fields: [branchSnapshotId], references: [id], onDelete: SetNull)

  @@index([projectConnectionId])
  @@map("vercel_deployment")
}
