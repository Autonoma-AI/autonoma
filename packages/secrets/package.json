{
    "name": "@autonoma/secrets",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./fake-key-provider": "./test/fake-key-provider.ts"
    },
    "scripts": {
        "test": "vitest run --passWithNoTests",
        "lint-files": "oxlint",
        "lint": "pnpm lint-files .",
        "fmt": "oxfmt --write src/",
        "build": "tsc --noCheck",
        "typecheck": "tsc --noEmit",
        "secret-value": "dotenv -e ../../.env -- tsx src/scripts/secret-value.ts"
    },
    "dependencies": {
        "@autonoma/db": "workspace:*",
        "@autonoma/errors": "workspace:*",
        "@autonoma/logger": "workspace:*",
        "@autonoma/utils": "workspace:*",
        "@aws-sdk/client-kms": "catalog:",
        "@t3-oss/env-core": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@autonoma/integration-test": "workspace:*",
        "@types/node": "catalog:",
        "dotenv-cli": "^11.0.0",
        "testcontainers": "^11.12.0",
        "tsx": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    }
}
