{
    "name": "@autonoma/agent-guidance",
    "version": "0.0.1",
    "private": true,
    "description": "One source of truth for the guidance Autonoma gives an agent or human when a request cannot proceed",
    "type": "module",
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "build": "tsc --noCheck",
