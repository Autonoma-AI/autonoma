{
    "name": "@autonoma/k8s",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./eks": "./src/eks-kubeconfig.ts",
        "./preview-liveness": "./src/preview-liveness/index.ts",
        "./preview-reaper": "./src/preview-reaper/index.ts",
        "./previewkit-jobs": "./src/previewkit-jobs/index.ts",
        "./previewkit-jobs/env": "./src/previewkit-jobs/env.ts"
    },
    "scripts": {
        "build": "tsc --noCheck",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint --fix src/",
        "fmt": "oxfmt --write src/",
        "test": "vitest run --passWithNoTests",
        "test:integration": "vitest run --config vitest.integration.config.ts"
    },
    "dependencies": {
        "@autonoma/db": "workspace:*",
        "@autonoma/github": "workspace:*",
        "@autonoma/logger": "workspace:*",
        "@autonoma/types": "workspace:*",
        "@aws-crypto/sha256-js": "^5.2.0",
        "@aws-sdk/client-eks": "^3.1105.0",
        "@aws-sdk/credential-provider-node": "^3.972.78",
        "@kubernetes/client-node": "catalog:",
        "@smithy/protocol-http": "^5.3.14",
        "@smithy/signature-v4": "^5.6.10",
        "@t3-oss/env-core": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@autonoma/integration-test": "workspace:*",
        "@types/node": "catalog:",
        "dotenv": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    }
}
